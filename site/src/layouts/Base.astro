---
import '../styles/global.css';
import { loadSite } from '../lib/data';
const cfg = await loadSite(Astro.locals);
const groupName = cfg.group.name;
// 로고 글자: 상위 그룹 이름을 뗀 첫 글자 (NCT DREAM → D)
const mark = cfg.group.parentNames.reduce((n, p) => n.replace(new RegExp(`^${p}\\s*`, 'i'), ''), groupName).slice(0, 1);

interface Props {
  title: string;
  current: 'schedule' | 'news' | 'archive' | 'series' | 'game' | 'ask' | 'report' | 'admin';
  /** 검색에 안 나오게 (어드민) */
  noindex?: boolean;
  /** 'dark': 헤더까지 어두운 화면 (응원법 게임 플레이) */
  theme?: 'dark';
}
const { title, current, noindex, theme } = Astro.props;
const nav = [
  { id: 'schedule', href: '/', label: '일정' },
  { id: 'news', href: '/news/', label: '소식' },
  { id: 'archive', href: '/archive/', label: '아카이브' },
  { id: 'series', href: '/series/', label: '시리즈' },
  { id: 'game', href: '/game/', label: '응원법' },
  { id: 'ask', href: '/ask/', label: '물어보기' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 드림로그</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#c5f03a" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body class={theme === 'dark' ? 'theme-dark' : undefined}>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${groupName} 드림로그`}><span class="brand-mark">{mark}</span><span class="brand-name">{groupName}</span> <small>드림로그</small></a>
        <nav class="nav" aria-label="주요 메뉴">
          {nav.map((n) => <a href={n.href} aria-current={n.id === current ? 'page' : undefined}>{n.label}</a>)}
          <a class="report-btn" href="/report/" aria-current={current === 'report' ? 'page' : undefined}>제보</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="wrap site-foot">드림로그는 팬이 만든 {groupName} 비공식 아카이브예요. 일정과 소식은 공식 공지와 기사를 바탕으로 정리했어요. 중요한 내용은 원문에서 한 번 더 확인해 주세요.</footer>
  </body>
</html>
