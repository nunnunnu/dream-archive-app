---
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/data';
const members = (await loadSite(Astro.locals)).members.map((m) => m.name);
---
<Base title="제보" current="report">
  <section class="report-hero">
    <div class="wrap hero-inner">
      <div>
        <p class="eyebrow">REPORT · 제보</p>
        <h1>빠진 일정이나 틀린 정보<br /><em>알려 주세요</em></h1>
        <p class="hero-copy">링크를 같이 보내 주시면 더 빨리 확인할 수 있어요.<br />보통 30분 안에 반영돼요.</p>
      </div>
      <div class="hero-proof" aria-label="제보 처리 과정">
        <span><b>1</b> 보내기</span><i></i><span><b>2</b> 확인</span><i></i><span><b>3</b> 반영</span>
      </div>
    </div>
  </section>

  <main class="wrap report">
    <div class="report-grid">
      <form class="card report-form" id="report-form">
        <div class="form-head">
          <div><span class="step-label">STEP 1</span><h2>어떤 내용인가요?</h2></div>
          <span class="time-badge">보통 30분 안</span>
        </div>

        <fieldset class="types">
          <legend class="sr-only">제보 종류</legend>
          <label><input type="radio" name="type" value="add" checked /><span class="type-icon">＋</span><b>빠진 일정</b><small>없는 일정을 알려 주세요</small></label>
          <label><input type="radio" name="type" value="fix" /><span class="type-icon">↻</span><b>정보 수정</b><small>날짜·시간·멤버가 틀렸어요</small></label>
          <label><input type="radio" name="type" value="delete" /><span class="type-icon">×</span><b>삭제 요청</b><small>지워야 할 일정·소식이 있어요</small></label>
          <label><input type="radio" name="type" value="news" /><span class="type-icon">✦</span><b>소식 알려주기</b><small>화보·광고·SNS 소식을 알려 주세요</small></label>
        </fieldset>

        <div class="form-divider"><span class="step-label">STEP 2</span><b>자세히 알려 주세요</b></div>

        <label class="field" id="title-field"><span id="title-label">일정·소식 이름</span><input name="title" placeholder="예: SBS 인기가요 사전녹화 / 위드뮤 뮤직뱅크 팬사인회 공지" /></label>

        <div class="field" id="target-field" hidden>
          <span>무엇을 지울까요?</span>
          <div class="seg-pick">
            <label><input type="radio" name="target" value="event" checked /> 일정</label>
            <label><input type="radio" name="target" value="news" /> 소식</label>
          </div>
        </div>

        <div class="field" id="news-field" hidden>
          <span>지울 소식</span>
          <p class="event-box" id="news-box">소식 화면에서 "삭제 요청"을 누르면 자동으로 들어가요. 직접 넣으려면 아래에 소식 링크(원문 주소)를 붙여 주세요.</p>
          <input type="hidden" name="newsTitle" />
          <input name="newsUrl" type="url" placeholder="소식 원문 주소 (기사·영상·공지)" />
        </div>

        <div class="field" id="event-field" hidden>
          <span>기존 일정 선택</span>
          <p class="event-box" id="event-box">일정 화면에서 들어오면 자동으로 선택돼요. 직접 찾으려면 아래에서 검색하세요.</p>
          <input type="hidden" name="eventId" />
          <input type="hidden" name="eventTitle" />
          <input type="hidden" name="eventSnapshot" />
          <input id="event-search" type="search" placeholder="날짜·일정명·멤버 검색" autocomplete="off" />
          <div class="event-results" id="event-results"></div>
        </div>

        <label class="field" id="link-field"><span>근거 링크 <small>있으면 더 빨리 반영돼요</small></span><input name="url" type="url" placeholder="위버스 공지·유튜브·기사 주소" /></label>

        <div class="row" id="when-fields">
          <label class="field"><span id="date-label">날짜</span><input name="date" type="date" /></label>
          <label class="field"><span id="time-label">시간</span><input name="time" type="time" /></label>
        </div>

        <div class="row" id="end-fields">
          <label class="field"><span>종료·마감 날짜 <small>선택</small></span><input name="endDate" type="date" /></label>
          <label class="field"><span>종료·마감 시간 <small>선택</small></span><input name="endTime" type="time" /></label>
        </div>

        <label class="field" id="reason-field" hidden><span>삭제 요청 이유</span><select name="reasonCode"></select></label>

        <div class="field" id="member-field"><span>멤버 <small>안 고르면 단체 일정으로 볼게요</small></span>
          <div class="chips">{members.map((m) => <label class="chip-check"><input type="checkbox" name="members" value={m} />{m}</label>)}</div>
        </div>

        <label class="field"><span>덧붙일 내용 <small>선택</small></span><textarea name="message" rows="4" placeholder="예: 11/22 인기가요는 녹화가 아니라 생방송이에요"></textarea></label>
        <input name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="submit-row">
          <p class="privacy">연락처·이름 같은 개인정보는 적지 말아 주세요.</p>
          <button type="submit" class="submit">제보 보내기</button>
        </div>
        <p class="result" id="result" role="status"></p>
      </form>

      <aside class="guide">
        <section class="card guide-card strong">
          <span class="guide-kicker">빠른 반영</span>
          <h3>링크가 있으면 더 빨라요</h3>
          <p>위버스 공지·공식 영상·기사 링크를 보내 주시면 내용을 확인해서 바로 일정에 올려요.</p>
          
        </section>
        <section class="card guide-card">
          <span class="guide-kicker">소식 알려주기</span>
          <h3>일정이 아닌 소식도 받아요</h3>
          <p>X 게시물이나 음반 판매처 공지처럼 일정이 아닌 소식도 알려 주세요. 소식 탭에 올리고 날짜가 있으면 일정에도 넣어요.</p>
        </section>
        <section class="card guide-card">
          <span class="guide-kicker muted">삭제 요청</span>
          <h3>일정도 소식도 지울 수 있어요</h3>
          <p>드림 일정·소식이 아닌 게 분명하면 바로 지우고 애매한 건 한 번 더 확인한 뒤 지워요. 권리자·초상권이나 사생활 요청은 바로 내려요.</p>
        </section>
        <p class="safe-note"><b>링크 없이 보내도 되나요?</b><br />네. 확인하는 데 조금 더 걸릴 수 있어요.</p>
      </aside>
    </div>
  </main>
</Base>

<style>
  .seg-pick { display: flex; gap: 8px; }
  .seg-pick label { display: flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px; font-weight: 600; cursor: pointer; }
  .report-hero { background: var(--dark); color: #fff; border-bottom: 1px solid #292929; }
  .hero-inner { min-height: 300px; display: flex; align-items: center; justify-content: space-between; gap: 56px; padding-top: 46px; padding-bottom: 46px; }
  .report-hero .eyebrow { margin: 0 0 14px; color: var(--accent); }
  .report-hero h1 { margin: 0; font-size: clamp(34px, 4.3vw, 54px); line-height: 1.08; letter-spacing: -.055em; }
  .report-hero h1 em { color: var(--accent); font-style: normal; }
  .hero-copy { margin: 18px 0 0; color: #aaa; font-size: 15px; }
  .hero-proof { min-width: 250px; padding: 22px; border: 1px solid #343434; border-radius: 16px; background: #191919; display: grid; gap: 0; }
  .hero-proof span { display: flex; align-items: center; gap: 12px; font-weight: 700; }
  .hero-proof b { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 7px; background: var(--accent); color: var(--accent-ink); font-size: 12px; }
  .hero-proof i { width: 1px; height: 20px; margin-left: 13px; background: #3d3d3d; }
  .report { padding-top: 34px; }
  .report-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
  .report-form { padding: 26px; display: flex; flex-direction: column; gap: 20px; }
  .form-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .form-head h2 { margin: 2px 0 0; font-size: 22px; letter-spacing: -.03em; }
  .step-label, .guide-kicker { color: #729100; font-size: 11px; font-weight: 900; letter-spacing: .08em; }
  .time-badge { border-radius: 999px; padding: 6px 11px; background: var(--today); color: #526600; font-size: 12px; font-weight: 800; }
  .types { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .types label { position: relative; border: 1px solid var(--line); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 2px; cursor: pointer; min-height: 112px; }
  .types label:has(input:checked) { border-color: #8db600; box-shadow: inset 0 0 0 1px #8db600; background: #fbfff1; }
  .types input { position: absolute; opacity: 0; }
  .types .type-icon { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 7px; background: var(--bg); font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .types label:has(input:checked) .type-icon { background: var(--accent); color: var(--accent-ink); }
  .types small { color: var(--sub); font-size: 12px; }
  .form-divider { border-top: 1px solid var(--line-soft); padding-top: 20px; display: flex; flex-direction: column; gap: 2px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field > span { font-weight: 750; font-size: 14px; }
  .field > span small { color: var(--faint); font-weight: 500; margin-left: 5px; }
  input, textarea, select { width: 100%; font: inherit; font-size: 14px; border: 1px solid var(--line); border-radius: 10px; padding: 11px 12px; background: #fff; outline: none; }
  input:focus, textarea:focus, select:focus { border-color: #8db600; box-shadow: 0 0 0 3px rgba(197, 240, 58, .2); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .event-box { margin: 0; color: var(--sub); font-size: 13px; background: var(--bg); border-radius: 10px; padding: 10px 12px; }
  .event-box.selected { background: var(--today); color: var(--text); font-weight: 700; }
  .event-results { display: grid; gap: 5px; }
  .event-results:empty { display: none; }
  .event-result { border: 1px solid var(--line); background: #fff; border-radius: 9px; padding: 9px 11px; text-align: left; cursor: pointer; }
  .event-result:hover { border-color: #8db600; background: #fbfff1; }
  .event-result b { display: block; font-size: 13px; }
  .event-result small { color: var(--sub); }
  .chip-check { border: 1px solid var(--line); border-radius: 999px; padding: 6px 13px; font-size: 13px; cursor: pointer; }
  .chip-check:has(input:checked) { background: var(--dark); color: #fff; border-color: var(--dark); }
  .chip-check input { display: none; }
  .hp { position: absolute; left: -9999px; }
  .submit-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid var(--line-soft); padding-top: 20px; }
  .privacy { color: var(--sub); font-size: 12px; margin: 0; }
  .submit { border: 0; background: var(--dark); color: #fff; font-weight: 800; border-radius: 11px; padding: 12px 22px; cursor: pointer; font-size: 14px; white-space: nowrap; }
  .submit:hover { background: #2b2b2b; }
  .result { margin: -8px 0 0; padding: 10px 12px; border-radius: 9px; background: var(--today); font-weight: 650; }
  .result:empty { display: none; }
  .guide { display: flex; flex-direction: column; gap: 12px; }
  .guide-card { padding: 20px; }
  .guide-card.strong { border-top: 3px solid var(--accent); }
  .guide-kicker.muted { color: var(--sub); }
  .guide-card h3 { margin: 5px 0 8px; font-size: 17px; letter-spacing: -.025em; }
  .guide-card p { margin: 0; color: var(--sub); font-size: 13px; }
  .source-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 14px; }
  .source-tags span { padding: 4px 8px; border-radius: 999px; background: var(--bg); color: #555; font-size: 11px; font-weight: 700; }
  .safe-note { margin: 3px 4px; color: var(--sub); font-size: 12px; }
  .safe-note b { color: var(--text); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 1000px) { .types { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 820px) {
    .hero-inner { min-height: auto; align-items: flex-start; flex-direction: column; gap: 30px; }
    .hero-proof { width: 100%; grid-template-columns: 1fr 20px 1fr 20px 1fr; align-items: center; padding: 16px; }
    .hero-proof span { gap: 7px; font-size: 12px; }
    .hero-proof i { width: 100%; height: 1px; margin: 0; }
    .report-grid { grid-template-columns: 1fr; }
    .guide { display: grid; grid-template-columns: 1fr 1fr; }
    .safe-note { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .hero-inner { padding-top: 36px; padding-bottom: 36px; }
    .report-hero h1 { font-size: 35px; }
    .hero-copy br { display: none; }
    .hero-proof { display: none; }
    .report { padding-top: 18px; }
    .report-form { padding: 18px; }
    .types { grid-template-columns: 1fr; }
    .types label { min-height: 0; display: grid; grid-template-columns: 28px 1fr; column-gap: 9px; padding: 12px; }
    .types .type-icon { grid-row: 1 / 3; margin: 0; }
    .types b, .types small { grid-column: 2; }
    .row, .guide { grid-template-columns: 1fr; }
    .submit-row { align-items: stretch; flex-direction: column; }
    .submit { width: 100%; }
  }
</style>

<script>
  const form = document.getElementById('report-form') as HTMLFormElement;
  const params = new URLSearchParams(location.search);
  const setType = (t: string) => {
    const radio = form.querySelector<HTMLInputElement>(`input[name="type"][value="${t}"]`);
    if (radio) radio.checked = true;
    update();
  };
  const REASONS = {
    event: [['duplicate', '같은 일정이 중복됐어요'], ['unrelated', 'NCT DREAM 일정이 아니에요'], ['wrong', '틀린 정보예요'], ['cancelled', '취소된 일정이에요'], ['other', '기타']],
    news: [['unrelated', 'NCT DREAM 소식이 아니에요'], ['duplicate', '같은 소식이 또 있어요'], ['wrong', '틀린 내용이에요'], ['rights', '권리자·초상권 요청이에요'], ['privacy', '사생활을 침해해요'], ['other', '기타']],
  } as const;
  let reasonFor = '';
  function update() {
    const fd = new FormData(form);
    const type = fd.get('type');
    const target = fd.get('target') === 'news' ? 'news' : 'event';
    const isNew = type === 'add' || type === 'news';
    const newsDel = type === 'delete' && target === 'news';
    (document.getElementById('target-field') as HTMLElement).hidden = type !== 'delete';
    (document.getElementById('news-field') as HTMLElement).hidden = !newsDel;
    (document.getElementById('member-field') as HTMLElement).hidden = type === 'delete';
    const sel = form.elements.namedItem('reasonCode') as HTMLSelectElement;
    if (reasonFor !== target) {
      reasonFor = target;
      sel.innerHTML = '<option value="">이유를 골라 주세요</option>' + REASONS[target].map(([v, t]) => `<option value="${v}">${t}</option>`).join('');
    }
    (document.getElementById('event-field') as HTMLElement).hidden = isNew || newsDel;
    (document.getElementById('title-field') as HTMLElement).hidden = !isNew;
    (document.getElementById('title-label') as HTMLElement).textContent = type === 'news' ? '어떤 소식인가요? (한 줄)' : '일정·소식 이름';
    (document.getElementById('time-label') as HTMLElement).closest('label')!.hidden = type === 'news';
    (document.getElementById('link-field') as HTMLElement).hidden = type === 'delete';
    (document.getElementById('reason-field') as HTMLElement).hidden = type !== 'delete';
    (document.getElementById('date-label') as HTMLElement).textContent = type === 'fix' ? '올바른 날짜' : '날짜';
    (document.getElementById('time-label') as HTMLElement).textContent = type === 'fix' ? '올바른 시간' : '시간';
    (document.getElementById('date-label') as HTMLElement).textContent = type === 'fix' ? '올바른 날짜' : type === 'news' ? '소식 날짜 (선택)' : '날짜';
    (document.getElementById('when-fields') as HTMLElement).hidden = type === 'delete';
    (document.getElementById('end-fields') as HTMLElement).hidden = type !== 'add';
  }
  form.addEventListener('change', update);
  if (params.get('type')) setType(params.get('type')!);
  if (params.get('date')) (form.elements.namedItem('date') as HTMLInputElement).value = params.get('date')!;
  if (params.get('news')) {
    (form.querySelector('input[name="target"][value="news"]') as HTMLInputElement).checked = true;
    (form.elements.namedItem('newsUrl') as HTMLInputElement).value = params.get('news')!;
    (form.elements.namedItem('newsTitle') as HTMLInputElement).value = params.get('title') ?? '';
    const box = document.getElementById('news-box') as HTMLElement;
    box.textContent = params.get('title') ?? params.get('news')!;
    box.classList.add('selected');
  }
  if (params.get('event')) {
    (form.elements.namedItem('eventId') as HTMLInputElement).value = params.get('event')!;
    (form.elements.namedItem('eventTitle') as HTMLInputElement).value = params.get('title') ?? '';
    const box = document.getElementById('event-box') as HTMLElement;
    box.textContent = params.get('title') ?? '';
    box.classList.add('selected');
  }
  update();

  type EventHit = { id: string; date: string; time: string | null; endDate: string | null; endTime: string | null; title: string; step: string; members: string[] };
  const search = document.getElementById('event-search') as HTMLInputElement;
  const results = document.getElementById('event-results') as HTMLElement;
  let timer: ReturnType<typeof setTimeout>;
  const choose = (e: EventHit) => {
    (form.elements.namedItem('eventId') as HTMLInputElement).value = e.id;
    (form.elements.namedItem('eventTitle') as HTMLInputElement).value = `${e.date} ${e.title} · ${e.step}`;
    (form.elements.namedItem('eventSnapshot') as HTMLInputElement).value = JSON.stringify(e);
    const box = document.getElementById('event-box') as HTMLElement;
    box.textContent = `${e.date}${e.time ? ` ${e.time}` : ''} · ${e.title} · ${e.step}${e.members.length ? ` · ${e.members.join('·')}` : ''}`;
    box.classList.add('selected');
    search.value = '';
    results.replaceChildren();
  };
  search.addEventListener('input', () => {
    clearTimeout(timer);
    const q = search.value.trim();
    if (q.length < 2) { results.replaceChildren(); return; }
    timer = setTimeout(async () => {
      const data = await fetch(`/api/events/search?q=${encodeURIComponent(q)}`).then((r) => r.json()).catch(() => ({ events: [] }));
      results.replaceChildren(...(data.events as EventHit[]).map((e) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'event-result';
        const title = document.createElement('b');
        title.textContent = `${e.date}${e.time ? ` ${e.time}` : ''} · ${e.title}`;
        const sub = document.createElement('small');
        sub.textContent = `${e.step}${e.members.length ? ` · ${e.members.join('·')}` : ' · 단체'}`;
        button.append(title, sub);
        button.addEventListener('click', () => choose(e));
        return button;
      }));
    }, 250);
  });

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(form);
    const body = Object.fromEntries(fd.entries()) as Record<string, unknown>;
    body.members = fd.getAll('members');
    if (typeof body.eventSnapshot === 'string' && body.eventSnapshot) {
      try { body.eventSnapshot = JSON.parse(body.eventSnapshot); } catch { body.eventSnapshot = null; }
    }
    const result = document.getElementById('result') as HTMLElement;
    result.textContent = '보내는 중…';
    try {
      const res = await fetch('/api/report', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json().catch(() => ({ ok: false, error: '서버 응답이 없어요' }));
      result.textContent = data.ok ? '고마워요! 확인해서 보통 30분 안에 반영할게요.' : `보내지 못했어요: ${data.error}`;
      if (data.ok) { form.reset(); reasonFor = ''; update(); }
    } catch {
      result.textContent = '보내지 못했어요. 잠시 뒤에 다시 시도해 주세요.';
    }
  });
</script>
