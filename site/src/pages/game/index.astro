---
/** 응원법 게임 곡 선택: 공개(verified) 채보만 (KV fanchant-index, 어드민 저장 때 갱신) */
import Base from '../../layouts/Base.astro';
import { readIndex } from '../../lib/fanchant-kv';
import '../../styles/game.css';
const songs = (await readIndex(Astro.locals.runtime?.env?.REPORTS)).filter((s) => s.verified);
const dots = (n: number) => '●'.repeat(n) + '○'.repeat(5 - n);
---
<Base title="응원법 게임" current="game">
  <main class="wrap game-home">
    <section class="game-hero">
      <p class="eyebrow">FANCHANT · 응원법 게임</p>
      <h1>응원법, <em>외웠는지</em> 눌러서 확인해요</h1>
      <p class="game-lede">응원할 순간에 스페이스바(폰은 응원봉)를 누르면 돼요. 1단계부터 힌트를 하나씩 줄여 가며 외워 보세요.</p>
    </section>
    <div class="game-modes" role="tablist" aria-label="모드">
      <button type="button" role="tab" class="game-mode" data-mode="step1" aria-selected="true">1단계</button>
      <button type="button" role="tab" class="game-mode" data-mode="step2" aria-selected="false">2단계</button>
      <button type="button" role="tab" class="game-mode" data-mode="step3" aria-selected="false">3단계</button>
      <button type="button" role="tab" class="game-mode" data-mode="live" aria-selected="false">실전</button>
    </div>
    <p class="game-mode-hint" id="mode-hint">1단계 · 노트와 응원 문구가 모두 보여요</p>
    <p class="game-ad-note">유튜브 영상이라 광고가 나올 수 있어요. 광고가 끝나면 게임이 시작돼요.</p>
    {songs.length ? (
      <div class="game-grid">
        {songs.map((s) => (
          <article class="card game-card" data-song={s.songId}>
            {s.coverYoutubeId && <img src={`https://img.youtube.com/vi/${s.coverYoutubeId}/hqdefault.jpg`} alt="" loading="lazy" />}
            <div class="game-card-body">
              <h2>{s.title}</h2>
              <div class="game-card-meta"><span class="game-dots" aria-label={`난이도 ${s.difficulty}/5`}>{dots(s.difficulty)}</span><span>{s.difficultyLabel}</span><span>노트 {s.noteCount}</span>{s.year && <span>{s.year}</span>}</div>
              <div class="game-best-slot"><span class="game-best-empty">최고 기록 없음</span></div>
              <div class="game-card-actions">
                <a class="game-btn is-accent game-mini" data-play="step1" href={`/game/play?song=${s.songId}&mode=step1`}>1단계</a>
                <a class="game-btn game-mini" data-play="step2" href={`/game/play?song=${s.songId}&mode=step2`}>2단계</a>
                <a class="game-btn game-mini" data-play="step3" href={`/game/play?song=${s.songId}&mode=step3`} aria-disabled={s.hasMv ? undefined : 'true'} title={s.hasMv ? undefined : '아직 뮤비 버전이 없어요'}>3단계</a>
                <a class="game-btn game-mini" data-play="live" href={`/game/play?song=${s.songId}&mode=live`} aria-disabled={s.hasMv ? undefined : 'true'} title={s.hasMv ? undefined : '아직 뮤비 버전이 없어요'}>실전</a>
              </div>
              <span class="game-card-meta">채보 {s.author}</span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="card game-empty">아직 공개된 채보가 없어요.</div>
    )}
    <p class="game-calib">타이밍 보정 (계속 늦게 눌린다고 나오면 +)
      <button type="button" data-calib="-10" aria-label="타이밍 보정 10ms 당기기">−</button>
      <b id="g-calib">0ms</b>
      <button type="button" data-calib="10" aria-label="타이밍 보정 10ms 늦추기">+</button>
        <button type="button" class="game-calib-reset" data-calib="reset" aria-label="타이밍 보정 초기화">초기화</button>
    </p>
  </main>
</Base>
<script src="../../scripts/game/select.ts"></script>
