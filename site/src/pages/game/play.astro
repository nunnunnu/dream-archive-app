---
/** 응원법 게임 플레이: /game/play?song=<곡ID>&mode=step1|step2|live&from=&to= (공개된 채보만) */
import Base from '../../layouts/Base.astro';
import GamePlay from '../../components/GamePlay.astro';
import { loadPublic } from '../../lib/data';
import { FANCHANT_DEFAULTS, SONG_ID, type FanchantChart, type FanchantConfig } from '../../lib/fanchant';
const q = Astro.url.searchParams;
const song = q.get('song') ?? '';
const mode = (['step1', 'step2', 'live'] as const).find((m) => m === q.get('mode')) ?? 'step1';
const from = q.has('from') ? Number(q.get('from')) : undefined;
const to = q.has('to') ? Number(q.get('to')) : undefined;
const chart = SONG_ID.test(song) ? await loadPublic<FanchantChart | null>(Astro.locals, `fanchant/${song}.json`, null) : null;
const index = await loadPublic<{ config?: Partial<FanchantConfig> }>(Astro.locals, 'fanchant/index.json', {});
const config = { ...FANCHANT_DEFAULTS, ...(index.config ?? {}) };
const range = from != null && to != null && Number.isFinite(from) && Number.isFinite(to) && to > from;
if (!chart) Astro.response.status = 404;
---
<Base title={chart ? `${chart.title} 응원법` : '응원법 게임'} current="game">
  {chart ? (
    <GamePlay chart={chart} config={config} mode={mode} from={range ? from : undefined} to={range ? to : undefined} backHref="/game/" />
  ) : (
    <main class="wrap" style="padding:40px 20px"><p>그 곡의 채보를 찾지 못했어요.</p><a href="/game/">곡 목록으로</a></main>
  )}
</Base>
