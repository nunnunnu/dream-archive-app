---
import Base from '../layouts/Base.astro';
import '../styles/ask.css';
// 처음 화면에 보여 줄 예시 질문
const examples = ['이번주 인가 어떻게 가?', '음중 사녹 모이는 곳 어디야?', '크래시2 어디서 볼 수 있어?', '팬사인회 언제야?', '다음주 월요일에 뭐 있어?', '이번 앨범 미공포 어디서 받아?'];
---
<Base title="물어보기" current="ask">
  <main class="wrap ask">
    <p class="eyebrow">ASK</p>
    <div class="section-head">
      <h2>물어보기</h2>
      <span class="note">수집한 공지·일정·기사로만 답해요 · 중요한 건 꼭 원문 공지를 확인하세요</span>
    </div>

    <section class="card chat" aria-live="polite">
      <div class="chat-log" id="chat-log">
        <div class="chat-empty" id="chat-empty">
          <p><b>사녹·방송·예매 일정</b>을 물어보세요. 근거가 된 공지·기사 링크를 함께 보여 드려요.</p>
          <div class="examples">{examples.map((q) => <button type="button" class="ex" data-q={q}>{q}</button>)}</div>
        </div>
      </div>

      <form class="chat-form" id="chat-form">
        <textarea id="chat-input" name="question" rows="1" maxlength="200" placeholder="예: 이번주 음중 사녹 신청 언제야?" aria-label="질문"></textarea>
        <input name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" id="chat-send" aria-label="보내기">보내기</button>
      </form>
    </section>
    <p class="ask-foot">답은 AI가 자료를 요약한 거라 틀릴 수 있어요. 👍/👎로 알려 주시면 답 품질을 고치는 데 써요. 질문·답만 저장하고 개인정보는 받지 않아요.</p>
  </main>
</Base>

<script src="../scripts/ask.ts"></script>
