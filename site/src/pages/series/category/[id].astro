---
import Base from '../../../layouts/Base.astro';
import SeriesShelf from '../../../components/SeriesShelf.astro';
import { loadPublic, type EraSummary, type SeriesSummary } from '../../../lib/data';
import { SERIES_CATEGORIES, seriesCategoryCards } from '../../../lib/series-categories';
import '../../../styles/series.css';

const category = SERIES_CATEGORIES.find(({ id }) => id === Astro.params.id);
if (!category) return new Response('없는 분류예요', { status: 404 });
const [{ series }, { eras }] = await Promise.all([
  loadPublic<{ series: SeriesSummary[] }>(Astro.locals, 'series.json', { series: [] }),
  loadPublic<{ eras: EraSummary[] }>(Astro.locals, 'eras.json', { eras: [] }),
]);
const cards = seriesCategoryCards(category, series, eras);
---
<Base title={category.name} current="series">
  <nav class="crumbs wrap" aria-label="경로"><a href="/series/">시리즈</a><span>/</span><b>{category.name}</b></nav>
  <main class="wrap">
    <SeriesShelf category={category} cards={cards} />
  </main>
</Base>
