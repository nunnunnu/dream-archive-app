---
import Base from '../../layouts/Base.astro';
import { loadPublic, ymd, type SeriesSummary } from '../../lib/data';
import '../../styles/series.css';

const { series } = await loadPublic<{ series: SeriesSummary[] }>(Astro.locals, 'series.json', { series: [] });
const TYPES = [
  { type: '자체 콘텐츠 시리즈', note: '회차로 이어지는 자컨 (시즌별)' },
  { type: '종류별 모아보기', note: '해마다 쌓이는 비하인드·안무·녹음' },
  { type: '고정 출연', note: '다른 채널에서 회차로 이어지는 예능' },
  { type: '반복 활동', note: '생일·시상식·개인·유닛 활동 모음' },
];
---
<Base title="시리즈" current="series">
  <main class="wrap">
    {TYPES.map(({ type, note }) => {
      const list = series.filter((s) => s.type === type);
      return list.length > 0 && (
        <section>
          <p class="eyebrow">SERIES</p>
          <div class="section-head"><h2>{type}</h2><span class="note">{note}</span></div>
          <div class="series-grid">
            {list.map((s) => (
              <a class="card series-card" href={`/series/${s.id}/`}>
                <span class="poster">{s.thumb ? <img src={s.thumb} alt="" loading="lazy" /> : <em>{s.name}</em>}</span>
                <span class="sc-body">
                  <span class="sc-type">{type}</span>
                  <b>{s.name}</b>
                  <small>{type === '반복 활동' ? `활동 ${s.count}개` : `${s.count}편`} · {ymd(s.from).slice(0, 7)} – {ymd(s.to).slice(0, 7)}</small>
                </span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </main>
</Base>
