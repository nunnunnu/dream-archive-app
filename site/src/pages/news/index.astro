---
/**
 * 소식: 올라오는 대로 최신순 한 줄 피드. 하루 단위로 묶는다 (오늘 · 어제 · 11.20 (금) …).
 *  - 카드: 왼쪽 썸네일(잘라 채우지 않고 비율 그대로 + 흐린 배경) · 오른쪽 시간·종류·제목·멤버·출처·원문
 *  - 같은 소식 기사는 한 카드로 묶고 펼치면 매체별 제목·시간·원문
 *  - 거르기: 종류(화보·광고·공항·차트·기사·영상·공지·SNS/제보) + 멤버(여러 명)
 *  - 자동으로 고른 하이라이트는 두지 않는다
 * 사진은 원문 주소에서 바로 불러온다 (서버에 저장하지 않음, referrer 없이 → 실패하면 색 배경). 다른 가수가 주인공일 수 있는 기사는 사진을 쓰지 않는다
 */
import Base from '../../layouts/Base.astro';
import { loadPublic } from '../../lib/data';

type Topic = '공항' | '광고' | '브랜드·화보' | '차트';
interface FeedItem {
  type: 'weverse-notice' | 'news' | 'youtube' | 'sns'; reported?: boolean; title: string; url: string; publishedAt: string; publisher?: string; count?: number;
  members: string[]; topic?: Topic; image?: string; shared?: boolean; articles?: { title: string; url: string; publisher: string; publishedAt: string }[]; duration?: number; live?: boolean;
}
const { items } = await loadPublic<{ items: FeedItem[] }>(Astro.locals, 'feed.json', { items: [] });
const now = Date.now();
const list = items.filter((i) => i.publishedAt >= new Date(now - 60 * 864e5).toISOString()).sort((a, b) => b.publishedAt.localeCompare(a.publishedAt)).slice(0, 1200);
const kst = (iso: string) => new Date(new Date(iso).getTime() + 9 * 3600e3).toISOString();
const day = (iso: string) => kst(iso).slice(0, 10);
const hm = (iso: string) => kst(iso).slice(11, 16);
const today = day(new Date(now).toISOString());
const yesterday = day(new Date(now - 864e5).toISOString());
const WD = ['일', '월', '화', '수', '목', '금', '토'];
const dayLabel = (d: string) => {
  const md = `${d.slice(5, 7)}.${d.slice(8, 10)} (${WD[new Date(`${d}T00:00:00Z`).getUTCDay()]})`;
  return d === today ? ['오늘', md] : d === yesterday ? ['어제', md] : [md, ''];
};
const clean = (t: string) => t.replace(/\s+-\s+[^-]{1,24}$/, '').replace(/\s+#\S+/g, '').trim() || t;
const yt = (url: string) => { try { const u = new URL(url); return u.hostname === 'youtu.be' ? u.pathname.slice(1) : u.searchParams.get('v'); } catch { return null; } };
const visual = (i: FeedItem) => (i.shared ? null : i.image ?? (i.type === 'youtube' && yt(i.url) ? `https://img.youtube.com/vi/${yt(i.url)}/hqdefault.jpg` : null));
const dur = (s?: number) => (s ? `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}` : '');
// 종류: 주제가 있으면 주제(화보·광고·공항·차트), 없으면 기사·영상·공지·SNS/제보
const KIND_OF = (i: FeedItem) => i.topic === '브랜드·화보' ? '화보' : i.topic ? i.topic : i.type === 'news' ? '기사' : i.type === 'youtube' ? '영상' : i.type === 'weverse-notice' ? '공지' : i.reported ? '제보' : 'SNS';
const KINDS = ['화보', '광고', '공항', '차트', '기사', '영상', '공지', 'SNS', '제보'];
const kindsShown = KINDS.filter((k) => list.some((i) => KIND_OF(i) === k));
const WORD: Record<string, string> = { 화보: 'PHOTO', 광고: 'AD', 공항: 'AIRPORT', 차트: 'CHART', 기사: 'NEWS', 영상: 'VIDEO', 공지: 'NOTICE', SNS: 'SNS', 제보: 'REPORT' };
const memberOrder = ['런쥔', '제노', '해찬', '재민', '천러', '지성'];
const members = [...new Set([...memberOrder.filter((m) => list.some((i) => i.members.includes(m))), ...list.flatMap((i) => i.members)])].filter((m) => m !== '단체');
const mc = (m: string) => `m${Math.max(0, members.indexOf(m)) % 7}`;
const outlets = (i: FeedItem) => new Set((i.articles ?? []).map((a) => a.publisher)).size;
const days = [...new Set(list.map((i) => day(i.publishedAt)))];
const SHOW_DAYS = 5;
const count = (k: string) => list.filter((i) => KIND_OF(i) === k).length;
// 크게 보이는 카드: 오늘 가장 최근 소식이 사진 있는 기사일 때만 (순서는 언제나 최신순 그대로)
const featureIdx = list[0] && day(list[0].publishedAt) === today && visual(list[0]) && list[0].type !== 'youtube' ? 0 : -1;
---
<Base title="소식" current="news">
  <main class="wrap nf" data-news>
    <header class="nf-hero">
      <div>
        <p class="eyebrow">NEWS · 소식</p>
        <h1>요즘 <mark>드림 소식</mark></h1>
        <p class="lead">화보·광고·공항·기사·영상을 새로 올라온 순서로 모았어요. 같은 소식을 다룬 기사는 한 줄로 묶었어요.</p>
      </div>
      <dl class="nf-stats">
        <div><dt>{count('화보') + count('광고')}</dt><dd>화보·광고</dd></div>
        <div><dt>{count('공항')}</dt><dd>공항</dd></div>
        <div><dt>{count('기사') + count('차트')}</dt><dd>기사</dd></div>
        <div><dt>{count('영상')}</dt><dd>영상</dd></div>
      </dl>
    </header>

    <div class="nf-filter" data-filters>
      <div class="chips" data-group="kind"><button aria-pressed="true" data-v="">전체</button>{kindsShown.map((k) => <button aria-pressed="false" data-v={k}>{k}</button>)}</div>
      <span class="div"></span>
      <div class="chips mem" data-group="member">{members.map((m) => <button class={mc(m)} aria-pressed="false" data-v={m}>{m}</button>)}</div>
      <span class="sort">● 최신순</span>
    </div>

    {days.map((d, di) => {
      const rows = list.filter((i) => day(i.publishedAt) === d);
      const [main, sub] = dayLabel(d);
      return (
        <section class="nf-day" data-day data-extra-day={di >= SHOW_DAYS ? '' : undefined} hidden={di >= SHOW_DAYS}>
          <header><h2>{main}{sub && <small>{sub}</small>}</h2><span>{rows.length}건</span></header>
          {rows.map((i) => {
            const k = KIND_OF(i);
            const img = visual(i);
            const grouped = (i.articles?.length ?? 0) > 1;
            const feat = list.indexOf(i) === featureIdx;
            return (
              <article class={`card nf-item${feat ? ' feat' : ''}`} data-kind={k} data-members={i.members.join(',')}>
                <a class={`thumb t-${WORD[k].toLowerCase()}${i.type === 'youtube' ? ' yt' : ''}`} href={i.url} target="_blank" rel="noopener" aria-label="원문 열기">
                  {img && (i.type === 'youtube'
                    ? <img class="main" src={img} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />
                    : <><img class="bg" src={img} alt="" aria-hidden="true" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" /><img class="main" src={img} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.previousElementSibling?.remove(); this.remove()" /></>)}
                  {!img && <span class="word"><b>{WORD[k]}</b><small>{i.publisher ?? ''}</small></span>}
                  {i.type === 'youtube' && <span class="play">▶</span>}
                  {i.live ? <em class="len live">● LIVE</em> : i.duration ? <em class="len">{dur(i.duration)}</em> : null}
                  {i.type !== 'youtube' && <span class="go">↗</span>}
                </a>
                <div class="body">
                  <p class="meta"><span class="time">{hm(i.publishedAt)}</span><span class={`badge b-${WORD[k].toLowerCase()}`}>{grouped ? `기사 ${i.count}건` : k}</span></p>
                  <h3><a href={i.url} target="_blank" rel="noopener">{clean(i.title)}</a></h3>
                  {i.members.length > 0 && <p class="mrow">{i.members.map((m) => <span class={`mchip ${mc(m)}`}>{m}</span>)}</p>}
                  <p class="foot"><span>{i.publisher ?? (i.type === 'weverse-notice' ? '위버스' : '')}{grouped && ` 외 ${outlets(i) - 1}곳`}</span>
                    {grouped ? <button type="button" class="toggle" data-toggle aria-expanded="false">{outlets(i)}개 매체 펼치기 ⌄</button> : <a class="src" href={i.url} target="_blank" rel="noopener">원문 ↗</a>}</p>
                </div>
                {grouped && <div class="outlets" hidden>
                  {i.articles!.map((a) => <a href={a.url} target="_blank" rel="noopener"><b>{a.publisher}</b><span>{clean(a.title)}<small>{hm(a.publishedAt)}</small></span><em>원문 ↗</em></a>)}
                  <p>같은 소식을 다룬 기사들이에요</p>
                </div>}
              </article>
            );
          })}
        </section>
      );
    })}
    <p class="empty" data-none hidden>조건에 맞는 소식이 없어요.</p>
    {days.length > SHOW_DAYS && <div class="more-wrap"><button type="button" class="more" data-more>이전 소식 더 보기</button></div>}

    <section class="nf-info">
            <div class="card"><b>내려야 할 소식이 있나요?</b><p>기사 본문은 옮기지 않고 제목과 링크만 모아요. 내려야 할 항목이 있으면 <a href="/report/">제보</a>로 알려 주세요. 바로 내릴게요. 빠진 소식도 <a href="/report/?type=news">소식 알려주기</a>로 보내 주세요.</p></div>
    </section>
  </main>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-news]')!;
  // 같은 소식 매체 펼치기
  for (const b of root.querySelectorAll<HTMLButtonElement>('[data-toggle]')) b.addEventListener('click', () => {
    const box = b.closest('.nf-item')!.querySelector<HTMLElement>('.outlets')!;
    box.hidden = !box.hidden;
    b.setAttribute('aria-expanded', String(!box.hidden));
    b.textContent = b.textContent!.replace(box.hidden ? '접기 ⌃' : '펼치기 ⌄', box.hidden ? '펼치기 ⌄' : '접기 ⌃');
  });
  // 이전 소식 더 보기: 5일씩
  root.querySelector('[data-more]')?.addEventListener('click', (e) => {
    const rest = [...root.querySelectorAll<HTMLElement>('[data-extra-day]')];
    for (const d of rest.slice(0, 5)) { d.hidden = false; delete d.dataset.extraDay; }
    if (rest.length <= 5) (e.currentTarget as HTMLElement).parentElement!.remove();
    apply();
  });
  // 거르기: 종류 하나 + 멤버 여러 명 (거를 때는 지난 날도 함께 본다)
  let kind = '';
  const picked = new Set<string>();
  function apply() {
    let shown = 0;
    for (const dayBox of root.querySelectorAll<HTMLElement>('[data-day]')) {
      if (dayBox.dataset.extraDay !== undefined && !kind && !picked.size) { dayBox.hidden = true; continue; }
      let n = 0;
      for (const it of dayBox.querySelectorAll<HTMLElement>('.nf-item')) {
        const ms = (it.dataset.members ?? '').split(',');
        const ok = (!kind || it.dataset.kind === kind) && (!picked.size || ms.some((m) => picked.has(m)));
        it.hidden = !ok;
        if (ok) n++;
      }
      dayBox.hidden = n === 0;
      shown += n;
    }
    (root.querySelector('[data-none]') as HTMLElement).hidden = shown > 0;
  }
  for (const group of root.querySelectorAll<HTMLElement>('[data-group]')) {
    for (const b of group.querySelectorAll<HTMLButtonElement>('button')) b.addEventListener('click', () => {
      if (group.dataset.group === 'member') {
        picked.has(b.dataset.v!) ? picked.delete(b.dataset.v!) : picked.add(b.dataset.v!);
        b.setAttribute('aria-pressed', String(picked.has(b.dataset.v!)));
      } else {
        for (const x of group.querySelectorAll('button')) x.setAttribute('aria-pressed', String(x === b));
        kind = b.dataset.v ?? '';
      }
      apply();
    });
  }
  // 멤버 문서에서 넘어오면 (?member=제노) 그 멤버로 거른다
  const want = new URLSearchParams(location.search).get('member');
  if (want) root.querySelector<HTMLButtonElement>(`[data-group="member"] button[data-v="${CSS.escape(want)}"]`)?.click();
</script>

<style>
  .nf { padding-bottom: 56px; }
  .nf-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; padding: 28px 0 18px; }
  .nf-hero .eyebrow { margin-top: 0; }
  .nf-hero h1 { margin: 6px 0 10px; font-size: clamp(32px, 4.6vw, 48px); line-height: 1.05; letter-spacing: -.05em; }
  .nf-hero mark { background: linear-gradient(transparent 62%, var(--accent) 0); color: inherit; }
  .lead { margin: 0; max-width: 560px; color: var(--sub); font-size: 14.5px; line-height: 1.6; }
  .nf-stats { display: flex; gap: 26px; margin: 0; flex: none; }
  .nf-stats dt { font-size: 24px; font-weight: 900; letter-spacing: -.04em; }
  .nf-stats dd { margin: 2px 0 0; color: var(--sub); font-size: 11.5px; }
  .nf-filter { position: sticky; top: 58px; z-index: 6; display: flex; align-items: center; gap: 10px; padding: 10px 0; margin-bottom: 6px; background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .nf-filter::-webkit-scrollbar { display: none; }
  .chips { display: flex; gap: 6px; flex: none; }
  .chips button { font: inherit; font-size: 13px; font-weight: 750; white-space: nowrap; border: 1px solid var(--line); background: var(--card); color: var(--text); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .chips button[aria-pressed='true'] { background: var(--dark); border-color: var(--dark); color: #fff; }
  .mem button { position: relative; padding-left: 22px; }
  .mem button::before { content: ''; position: absolute; left: 9px; top: 50%; width: 7px; height: 7px; border-radius: 50%; transform: translateY(-50%); background: var(--mc); }
  .div { width: 1px; height: 22px; background: var(--line); flex: none; }
  .sort { margin-left: auto; flex: none; color: #5d7a00; font-size: 12px; font-weight: 700; }
  .m0 { --mc: #6c8ef5; } .m1 { --mc: #f08a5d; } .m2 { --mc: #f2c23a; } .m3 { --mc: #ec67a6; } .m4 { --mc: #3fd3a6; } .m5 { --mc: #9a7cf0; } .m6 { --mc: #8ca9ff; }
  .nf-day { margin-top: 22px; }
  .nf-day > header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
  .nf-day h2 { margin: 0; font-size: 20px; letter-spacing: -.03em; display: flex; align-items: baseline; gap: 8px; }
  .nf-day h2 small { color: var(--sub); font-size: 13px; font-weight: 600; }
  .nf-day > header span { color: var(--faint); font-size: 12px; }
  .nf-item { display: grid; grid-template-columns: 220px minmax(0, 1fr); margin-bottom: 10px; overflow: hidden; padding: 0; border-radius: 16px; }
  .nf-item.feat { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .thumb { position: relative; display: block; min-height: 124px; overflow: hidden; background: linear-gradient(140deg, #26340d, #a7cf3a); text-decoration: none; }
  .feat .thumb { min-height: 260px; }
  .t-airport { background: linear-gradient(140deg, #6a2d1d, #ff9a69); } .t-ad { background: linear-gradient(140deg, #6b4a06, #f2c23a); } .t-photo { background: linear-gradient(140deg, #4a1430, #ec67a6); }
  .t-chart { background: linear-gradient(140deg, #2b2b2b, #9a9a9a); } .t-video { background: #000; } .t-notice { background: linear-gradient(140deg, #0d3b2c, #3fd3a6); } .t-sns, .t-report { background: linear-gradient(140deg, #22285c, #6c8ef5); }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .thumb .bg { object-fit: cover; filter: blur(18px) brightness(.72); transform: scale(1.25); }
  .thumb .main { object-fit: contain; }
  .thumb.yt { background: #000; }
  .word { position: absolute; left: 14px; bottom: 12px; display: flex; flex-direction: column; color: #fff; }
  .word b { font-size: 13px; letter-spacing: .16em; }
  .word small { opacity: .8; font-size: 11px; }
  .play { position: absolute; left: 50%; top: 50%; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; background: rgba(255,255,255,.92); color: #111; display: grid; place-items: center; font-size: 13px; padding-left: 2px; }
  .len { position: absolute; right: 8px; bottom: 8px; background: rgba(0,0,0,.78); color: #fff; font-style: normal; font-size: 11px; font-weight: 800; padding: 2px 6px; border-radius: 5px; }
  .len.live { background: #e0245e; }
  .go { position: absolute; right: 10px; top: 10px; width: 26px; height: 26px; border-radius: 50%; background: #fff; color: #111; display: grid; place-items: center; font-size: 12px; font-weight: 800; }
  .body { padding: 14px 18px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .feat .body { padding: 22px; justify-content: center; }
  .meta { margin: 0; display: flex; align-items: center; gap: 8px; }
  .time { color: var(--sub); font-size: 12px; font-weight: 700; }
  .badge { font-size: 10.5px; font-weight: 800; padding: 2px 7px; border-radius: 6px; background: var(--line-soft); }
  .b-photo, .b-news { background: var(--accent); color: var(--accent-ink); } .b-ad { background: #fff1c2; color: #7a5600; } .b-airport { background: #ffe2d6; color: #a1401c; }
  .b-video { background: var(--dark); color: #fff; } .b-notice { background: #d7f5ea; color: #0d6b4c; } .b-report, .b-sns { background: #e2e8ff; color: #2b4ac8; } .b-chart { background: #ececec; }
  .body h3 { margin: 0; font-size: 15.5px; line-height: 1.4; letter-spacing: -.02em; }
  .feat .body h3 { font-size: 21px; }
  .body h3 a { color: inherit; text-decoration: none; }
  .body h3 a:hover { text-decoration: underline; }
  .mrow { margin: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .mchip { position: relative; padding: 2px 8px 2px 18px; border: 1px solid var(--line); border-radius: 999px; font-size: 11px; background: #fff; }
  .mchip::before { content: ''; position: absolute; left: 7px; top: 50%; width: 6px; height: 6px; border-radius: 50%; transform: translateY(-50%); background: var(--mc); }
  .foot { margin: auto 0 0; display: flex; justify-content: space-between; align-items: center; gap: 10px; padding-top: 4px; color: var(--sub); font-size: 12px; }
  .src { color: var(--text); font-weight: 800; text-decoration: none; font-size: 12px; }
  .toggle { border: 0; background: var(--dark); color: #fff; font: inherit; font-size: 11.5px; font-weight: 800; border-radius: 999px; padding: 6px 11px; cursor: pointer; white-space: nowrap; }
  .outlets { grid-column: 1 / -1; border-top: 1px solid var(--line-soft); background: color-mix(in srgb, var(--bg) 50%, white); }
  .outlets a { display: grid; grid-template-columns: 110px minmax(0, 1fr) auto; gap: 12px; padding: 10px 18px; border-top: 1px solid var(--line-soft); color: inherit; text-decoration: none; font-size: 13px; }
  .outlets a:first-child { border-top: 0; }
  .outlets b { font-size: 12.5px; }
  .outlets span { display: flex; flex-direction: column; min-width: 0; }
  .outlets small { color: var(--faint); font-size: 11px; }
  .outlets em { font-style: normal; font-weight: 800; font-size: 12px; }
  .outlets p { margin: 0; padding: 8px 18px 12px; color: var(--faint); font-size: 11.5px; }
  .more-wrap { display: flex; flex-direction: column; align-items: center; gap: 6px; margin-top: 20px; }
  .more { border: 0; background: var(--dark); color: #fff; font: inherit; font-weight: 800; font-size: 13.5px; border-radius: 999px; padding: 11px 22px; cursor: pointer; }
  .more-wrap small { color: var(--faint); font-size: 11.5px; }
  .empty { color: var(--sub); text-align: center; padding: 40px 0; }
  .nf-info { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 32px; }
  .nf-info .card { padding: 16px 18px; }
  .nf-info b { font-size: 14px; }
  .nf-info p { margin: 6px 0 0; color: var(--sub); font-size: 12.5px; line-height: 1.6; }
  @media (max-width: 760px) {
    .nf-hero { flex-direction: column; align-items: flex-start; gap: 14px; }
    .nf-item, .nf-item.feat { grid-template-columns: 120px minmax(0, 1fr); }
    .thumb, .feat .thumb { min-height: 100px; }
    .feat .body { padding: 14px; }
    .feat .body h3 { font-size: 16px; }
    .body { padding: 12px 14px; }
    .body h3 { font-size: 14.5px; }
    .outlets a { grid-template-columns: 76px minmax(0, 1fr); }
    .outlets em { display: none; }
