---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { loadPublic, md, type EraSummary } from '../../lib/data';

const { eras } = await loadPublic<{ eras: EraSummary[] }>(Astro.locals, 'eras.json', { eras: [] });
// 활동은 끝난 해 기준으로 묶는다 (2025년에 시작해 2026년에 끝난 투어는 2026)
const yearOf = (e: EraSummary) => e.to.slice(0, 4);
const years = [...new Set(eras.map(yearOf))].sort().reverse();
const KIND_ORDER = ['컴백', '콘서트·투어', '팬미팅', '드라마', '예능', '시상식', '페스티벌', '팝업', '활동'];
---
<Base title="아카이브" current="archive">
  <main class="wrap">
    {years.map((y) => (
      <section>
        <h2 class="year">{y}</h2>
        <div class="era-list">
          {eras.filter((e) => yearOf(e) === y).sort((a, b) => KIND_ORDER.indexOf(a.kind) - KIND_ORDER.indexOf(b.kind) || b.from.localeCompare(a.from)).map((e) => (
            <a class="card era-card" href={`/archive/${e.id}/`}>
              <div class="era-cover"><Cover title={e.title} sub={e.subtitle} cover={e.cover} image={e.thumb} /></div>
              <div>
                <div class="era-tags"><span class="t lime">{e.kind}</span>{e.owner.scope !== '단체' && <span class="t owner">{e.owner.label}</span>}{e.status === '활동 중' && <span class="t dark">활동 중</span>}</div>
                <h3>{e.title}</h3>
                <p>{e.from.slice(0, 4) === e.to.slice(0, 4) ? `${md(e.from)} – ${md(e.to)}` : `${e.from.replaceAll('-', '.')} – ${md(e.to)}`}</p>
                <p class="sub">일정 {e.counts.events}{e.counts.official + e.counts.own + e.counts.outside ? ` · 영상 ${e.counts.official + e.counts.own + e.counts.outside}` : ''}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="eyebrow" style="margin-top:40px">MORE</p>
    <p style="color:var(--sub)">일정 제목 속 작품 이름(앨범·투어·팬미팅·드라마)으로 자동으로 묶은 활동이에요.</p>
  </main>
</Base>
<style>
  .year { font-size: 56px; letter-spacing: -0.05em; margin: 40px 0 16px; line-height: 1; display: inline-block; border-bottom: 6px solid var(--accent); }
  /* 작은 세로 카드를 한 줄에 여러 개 */
  .era-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .era-card { display: flex; flex-direction: column; gap: 8px; padding: 8px; text-decoration: none; }
  .era-cover { width: 100%; }
  .era-cover :global(.cover) { aspect-ratio: 1 / 1; box-shadow: 0 6px 14px rgba(0, 0, 0, 0.16); border-radius: 10px; }
  .era-cover :global(.cover-text strong) { font-size: 15px; }
  .era-cover :global(.cover-text) { left: 10px; right: 10px; bottom: 10px; }
  .era-tags { display: flex; gap: 4px; flex-wrap: wrap; }
  .t { font-size: 10.5px; font-weight: 800; padding: 2px 7px; border-radius: 999px; }
  .t.lime { background: var(--accent); color: var(--accent-ink); }
  .t.dark { background: var(--dark); color: var(--accent); }
  .t.owner { background: var(--line-soft); color: var(--text); }
  h3 { font-size: 15px; margin: 6px 0 2px; letter-spacing: -0.02em; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  p { margin: 0; color: var(--sub); font-size: 12px; }
  .sub { margin-top: 2px; color: var(--faint); font-size: 11.5px; }
  @media (max-width: 760px) { .era-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .year { font-size: 40px; } }
</style>
