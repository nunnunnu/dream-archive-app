---
/**
 * 아카이브 첫 화면: 숫자 요약·검색 → 멤버 문서(그룹 + 멤버, 생일 D-day) → 연도별 활동 카드(연도·종류 거르기) → 공백기 → 시리즈 바로가기.
 * 멤버 사진은 등록 채널의 최신 직캠 썸네일 (사진을 다시 올리지 않는다).
 */
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import MemberCard from '../../components/MemberCard.astro';
import { loadPublic, md, type EraSummary, type SeriesSummary } from '../../lib/data';
import { daysUntil, dday, EMPTY_MEMBERS, type MembersData } from '../../lib/members';

const [{ eras }, data, { series }] = await Promise.all([
  loadPublic<{ eras: EraSummary[] }>(Astro.locals, 'eras.json', { eras: [] }),
  loadPublic<MembersData>(Astro.locals, 'members.json', EMPTY_MEMBERS),
  loadPublic<{ series: SeriesSummary[] }>(Astro.locals, 'series.json', { series: [] }),
]);
const yearOf = (e: EraSummary) => e.from.slice(0, 4);
const years = [...new Set(eras.map(yearOf))].sort().reverse();
const KIND_ORDER = ['컴백', '콘서트·투어', '팬미팅', '드라마', '예능', '시상식', '페스티벌', '팝업', '활동'];
const KIND_SHORT: Record<string, string> = { 컴백: '컴백', '콘서트·투어': '투어', 팬미팅: '팬미팅', 드라마: '드라마', 시상식: '시상식', 페스티벌: '페스티벌', 팝업: '팝업', 활동: '활동', 예능: '예능' };
const kinds = KIND_ORDER.filter((k) => eras.some((e) => e.kind === k));
const yearSummary = (y: string) => {
  const list = eras.filter((e) => yearOf(e) === y);
  return KIND_ORDER.map((k) => [k, list.filter((e) => e.kind === k).length] as const).filter(([, n]) => n).map(([k, n]) => `${KIND_SHORT[k]} ${n}`).join(' · ');
};
const debutNext = data.group.debut ? daysUntil(data.group.debut.slice(5)) : null;
const quick = [data.members[1]?.name, eras.find((e) => e.status === '활동 중' && e.kind === '컴백')?.title, eras.find((e) => e.kind === '콘서트·투어')?.title].filter(Boolean) as string[];
// 시리즈 바로가기: 종류마다 가장 최근 것 하나
const seriesPick = [...new Map([...series].sort((a, b) => b.to.localeCompare(a.to)).map((s) => [s.type, s] as const)).values()].slice(0, 4);
const ymLabel = (ym: string) => `${ym.slice(0, 4)}년 ${Number(ym.slice(5, 7))}월`;
---
<Base title="아카이브" current="archive">
  <main class="wrap arc">
    <section class="arc-hero">
      <div>
        <p class="eyebrow">ARCHIVE</p>
        <h1>아카이브</h1>
        <p class="lead">멤버 문서부터 컴백·투어·공백기까지, NCT DREAM의 활동을 한곳에서 봐요. 일정과 소식은 공식 공지와 기사에서 <b>자동으로</b> 쌓여요.</p>
        <form class="arc-search" role="search" onsubmit="return false">
          <input type="search" id="arc-q" placeholder="멤버, 앨범, 투어, 예능 검색" aria-label="아카이브 검색" autocomplete="off" />
          <button type="button" id="arc-go">검색</button>
        </form>
        <p class="quick">바로가기 {quick.map((q) => <button type="button" class="chip" data-q={q}>{q}</button>)}</p>
      </div>
      <dl class="arc-stats">
        <div><dt>{data.stats.events.toLocaleString()}</dt><dd>기록된 일정</dd></div>
        <div><dt>{data.stats.news.toLocaleString()}</dt><dd>소식</dd></div>
        <div><dt>{data.stats.comebacks}</dt><dd>컴백</dd></div>
        <div><dt>{data.stats.tours}</dt><dd>투어</dd></div>
      </dl>
    </section>

    <section class="arc-sec" data-searchable>
      <p class="eyebrow">MEMBERS</p>
      <div class="sec-head"><h2>멤버 문서</h2><span>멤버별 활동을 한 문서에서</span></div>
      <a class="group-card" href="/member/nctdream/" data-name={`${data.group.name} 그룹`}>
        <span class="g-badge">D</span>
        <span class="g-text"><small>그룹 문서</small><b>{data.group.name || 'NCT DREAM'}</b>
          <em>{data.group.debut && <>데뷔 <strong>{data.group.debut.replaceAll('-', '.')}</strong> · </>}멤버 {data.members.length}{debutNext && <> · 다음 데뷔 기념일 {debutNext.days === 0 ? '오늘' : `D-${debutNext.days}`}</>}</em></span>
        <span class="g-go">문서 보기 →</span>
      </a>
      <div class="member-grid">
        {data.members.map((m) => {
          const today = m.birthday ? daysUntil(m.birthday).days === 0 : false;
          return (
            <a class="member" href={`/member/${m.slug}/`} data-name={`${m.name} ${m.en} ${m.realName ?? ''}`}>
              <MemberCard m={m} highlight={today} />
              <b>{m.name}</b><small>{m.en}</small>
              {m.birthday && <span class={`bday${today ? ' today' : ''}`}>{today ? '오늘 생일' : dday(m.birthday)} <em>{m.birthday.replace('-', '.')}</em></span>}
            </a>
          );
        })}
      </div>
    </section>

    <section class="arc-sec">
      <p class="eyebrow">ACTIVITIES</p>
      <div class="sec-head"><h2>활동 아카이브</h2><span>일정 제목 속 작품 이름으로 자동으로 묶어요</span></div>
      <div class="filters">
        <div class="chips" id="year-chips"><button type="button" class="chip on" data-year="">전체</button>{years.map((y) => <button type="button" class="chip" data-year={y}>{y}</button>)}</div>
        <div class="chips" id="kind-chips"><button type="button" class="chip dark on" data-kind="">유형 전체</button>{kinds.map((k) => <button type="button" class="chip" data-kind={k}>{KIND_SHORT[k]}</button>)}</div>
      </div>
      {years.map((y) => (
        <div class="year-row" data-year={y}>
          <div class="year-col"><h3>{y}</h3><i></i><small>{yearSummary(y)}</small></div>
          <div class="era-grid">
            {eras.filter((e) => yearOf(e) === y).sort((a, b) => KIND_ORDER.indexOf(a.kind) - KIND_ORDER.indexOf(b.kind) || b.from.localeCompare(a.from)).map((e) => (
              <a class="era" href={`/archive/${e.id}/`} data-kind={e.kind} data-name={`${e.title} ${e.subtitle ?? ''} ${e.kind} ${e.owner.label}`}>
                <Cover title={e.title} sub={e.subtitle} cover={e.cover} image={e.thumb} />
                <span class="era-tags"><span class="t lime">{KIND_SHORT[e.kind] ?? e.kind}</span>{e.owner.scope !== '단체' && <span class="t">{e.owner.label}</span>}{e.status === '활동 중' && <span class="t dark">활동 중</span>}</span>
                <b>{e.title}</b>
                <small>{e.from.replaceAll('-', '.')}{e.to !== e.from && ` – ${e.from.slice(0, 4) === e.to.slice(0, 4) ? md(e.to) : e.to.replaceAll('-', '.')}`}</small>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="empty" id="arc-empty" hidden>찾는 활동이 없어요. 다른 이름으로 검색해 보세요.</p>
    </section>

    {data.offSeason.length > 0 && (
      <section class="arc-sec">
        <p class="eyebrow">OFF-SEASON</p>
        <div class="sec-head"><h2>공백기</h2><span>최근 12달 중 컴백·투어가 없던 달에 있었던 일</span></div>
        <div class="off-grid">
          {data.offSeason.map((o) => (
            <a class="off" href={`/?month=${o.month}`}>
              <span class="off-cover"><b>{o.month.replace('-', '.')}</b></span>
              <b>{ymLabel(o.month)}</b>
              <small>{o.top.length ? o.top.map((t) => t.title).join(' · ') : '기록된 일정 없음'}</small>
              <em>일정 {o.count}</em>
            </a>
          ))}
        </div>
      </section>
    )}

    {seriesPick.length > 0 && (
      <section class="arc-sec">
        <p class="eyebrow">SERIES</p>
        <div class="sec-head"><h2>시리즈 바로가기</h2><a href="/series/">시리즈 전체 →</a></div>
        <div class="series-grid">
          {seriesPick.map((s) => (
            <a class="series" href={`/series/${s.id}/`}><span class="t">{s.type}</span><b>{s.name}</b><small>{s.from.slice(0, 4)}{s.to.slice(0, 4) !== s.from.slice(0, 4) && ` – ${s.to.slice(0, 4)}`} · {s.count}편</small></a>
          ))}
        </div>
      </section>
    )}
  </main>
</Base>

<script>
  const q = document.getElementById('arc-q') as HTMLInputElement;
  const state = { year: '', kind: '', q: '' };
  const norm = (s: string) => s.normalize('NFKC').toLowerCase().replace(/\s+/g, '');
  function apply() {
    const qq = norm(state.q);
    let shown = 0;
    for (const row of document.querySelectorAll<HTMLElement>('.year-row')) {
      let n = 0;
      for (const a of row.querySelectorAll<HTMLElement>('.era')) {
        const ok = (!state.year || row.dataset.year === state.year) && (!state.kind || a.dataset.kind === state.kind) && (!qq || norm(a.dataset.name ?? '').includes(qq));
        a.hidden = !ok;
        if (ok) n++;
      }
      row.hidden = n === 0;
      shown += n;
    }
    for (const m of document.querySelectorAll<HTMLElement>('.member, .group-card')) m.classList.toggle('dim', Boolean(qq) && !norm(m.dataset.name ?? '').includes(qq));
    (document.getElementById('arc-empty') as HTMLElement).hidden = shown > 0;
  }
  const pick = (box: string, key: 'year' | 'kind') => {
    for (const b of document.querySelectorAll<HTMLButtonElement>(`#${box} .chip`)) {
      b.addEventListener('click', () => {
        state[key] = b.dataset[key] ?? '';
        for (const x of document.querySelectorAll(`#${box} .chip`)) x.classList.toggle('on', x === b);
        apply();
      });
    }
  };
  pick('year-chips', 'year');
  pick('kind-chips', 'kind');
  q.addEventListener('input', () => { state.q = q.value; apply(); });
  document.getElementById('arc-go')?.addEventListener('click', () => { state.q = q.value; apply(); document.querySelector('.year-row:not([hidden])')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
  for (const b of document.querySelectorAll<HTMLButtonElement>('.quick .chip')) b.addEventListener('click', () => { q.value = b.dataset.q ?? ''; state.q = q.value; apply(); });
</script>

<style>
  .arc { padding-bottom: 64px; }
  .eyebrow { margin: 0 0 10px; letter-spacing: .12em; font-weight: 900; }
  .arc-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: start; padding: 26px 0 4px; }
  .arc-hero h1 { margin: 0 0 12px; font-size: clamp(36px, 5vw, 52px); letter-spacing: -.05em; line-height: 1; }
  .lead { margin: 0; max-width: 560px; color: var(--sub); font-size: 15px; line-height: 1.65; }
  .lead b { color: var(--text); }
  .arc-search { margin-top: 22px; max-width: 560px; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 6px 6px 18px; box-shadow: 0 6px 18px rgba(0,0,0,.05); }
  .arc-search input { flex: 1; border: 0; outline: none; font: inherit; font-size: 15px; background: transparent; min-width: 0; }
  .arc-search button { border: 0; background: var(--dark); color: #fff; font-weight: 800; border-radius: 999px; padding: 10px 16px; cursor: pointer; }
  .quick { margin: 12px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--sub); font-size: 12px; }
  .chip { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; color: var(--text); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .chip.dark.on { background: var(--dark); border-color: var(--dark); color: #fff; }
  .arc-stats { display: grid; grid-template-columns: repeat(2, minmax(120px, auto)); gap: 22px 40px; margin: 18px 0 0; }
  .arc-stats dt { font-size: 26px; font-weight: 900; letter-spacing: -.04em; }
  .arc-stats dd { margin: 2px 0 0; color: var(--sub); font-size: 12px; }
  .arc-sec { margin-top: 36px; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 18px; }
  .sec-head h2 { margin: 0; font-size: 26px; letter-spacing: -.035em; }
  .sec-head span, .sec-head a { color: var(--sub); font-size: 12px; }
  .group-card { display: flex; align-items: center; gap: 18px; padding: 14px 22px 14px 14px; border-radius: 16px; background: #0c0c0c; color: #fff; text-decoration: none; }
  .g-badge { width: 62px; height: 62px; border-radius: 14px; display: grid; place-items: center; background: linear-gradient(140deg, #e7ff8a, var(--accent)); color: #111; font-weight: 900; font-size: 26px; flex: none; }
  .g-text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .g-text small { color: var(--accent); font-size: 11px; font-weight: 800; }
  .g-text b { font-size: 20px; letter-spacing: -.02em; }
  .g-text em { font-style: normal; color: #aaa; font-size: 12px; }
  .g-text strong { color: #fff; }
  .g-go { color: var(--accent); font-weight: 800; font-size: 13px; white-space: nowrap; }
  .member-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  .member { display: flex; flex-direction: column; gap: 2px; color: inherit; text-decoration: none; transition: opacity .15s; }
  .member b { margin-top: 10px; font-size: 16px; }
  .member small { color: var(--sub); font-size: 11px; letter-spacing: .08em; }
  .bday { align-self: flex-start; margin-top: 6px; border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 3px 9px; font-size: 11.5px; font-weight: 800; }
  .bday em { font-style: normal; color: var(--faint); font-weight: 700; margin-left: 4px; }
  .bday.today { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .bday.today em { color: var(--accent-ink); }
  .dim { opacity: .3; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-bottom: 22px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .year-row { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 20px; padding: 16px 0; border-top: 1px solid var(--line-soft); }
  .year-col h3 { margin: 0; font-size: 30px; letter-spacing: -.04em; line-height: 1; }
  .year-col i { display: block; width: 34px; height: 5px; background: var(--accent); margin: 8px 0 6px; border-radius: 2px; }
  .year-col small { color: var(--sub); font-size: 11.5px; }
  .era-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 14px; }
  .era { display: flex; flex-direction: column; gap: 4px; color: inherit; text-decoration: none; min-width: 0; }
  .era :global(.cover) { box-shadow: 0 10px 22px rgba(0,0,0,.16); border-radius: 12px; }
  .era :global(.cover-text strong) { font-size: 16px; }
  .era :global(.cover-text) { left: 10px; right: 10px; bottom: 10px; }
  .era-tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 8px; }
  .t { font-size: 10.5px; font-weight: 800; padding: 2px 7px; border-radius: 6px; background: var(--line-soft); color: var(--text); }
  .t.lime { background: var(--accent); color: var(--accent-ink); }
  .t.dark { background: var(--dark); color: var(--accent); }
  .era b { font-size: 14px; letter-spacing: -.02em; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .era small { color: var(--sub); font-size: 11.5px; }
  .empty { color: var(--sub); padding: 30px 0; text-align: center; }
  .off-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
  .off { display: flex; flex-direction: column; gap: 3px; color: inherit; text-decoration: none; }
  .off-cover { height: 96px; border-radius: 12px; display: flex; align-items: flex-end; padding: 10px; background: linear-gradient(150deg, #1d2a3a, #9fb7d8); color: #fff; }
  .off:nth-child(3n+2) .off-cover { background: linear-gradient(150deg, #2c3a14, #c9e07a); }
  .off:nth-child(3n) .off-cover { background: linear-gradient(150deg, #4a3214, #e9c36a); }
  .off-cover b { font-size: 18px; letter-spacing: -.02em; }
  .off > b { margin-top: 6px; font-size: 13px; }
  .off small { color: var(--sub); font-size: 11.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .off em { font-style: normal; color: var(--faint); font-size: 11px; }
  .series-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .series { display: flex; flex-direction: column; gap: 6px; padding: 16px; background: #fff; border: 1px solid var(--line); border-radius: 14px; color: inherit; text-decoration: none; }
  .series .t { align-self: flex-start; }
  .series b { font-size: 15px; }
  .series small { color: var(--sub); font-size: 12px; }
  @media (max-width: 900px) {
    .arc-hero { grid-template-columns: 1fr; gap: 20px; }
    .arc-stats { grid-template-columns: repeat(4, auto); justify-content: start; gap: 12px 24px; }
    .member-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .series-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .arc-stats { grid-template-columns: repeat(2, auto); }
    .year-row { grid-template-columns: 1fr; gap: 12px; }
    .year-col { display: flex; align-items: baseline; gap: 10px; }
    .year-col i { display: none; }
    .era-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .group-card { flex-wrap: wrap; }
    .g-go { width: 100%; text-align: right; }
  }
</style>
