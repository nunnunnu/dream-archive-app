---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { groupNameRe, loadPublic, loadSite, md, ymd, type EraPage } from '../../lib/data';
import { readIndex } from '../../lib/fanchant-kv';
import '../../styles/era.css';
import '../../styles/guide.css';

const { id } = Astro.params;
const found = await loadPublic<EraPage | null>(Astro.locals, `eras/${id}.json`, null);
if (!found) return new Response('없는 활동이에요', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
const era = found;
const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
const OWN_PREVIEW = 8;
const STAGE_PREVIEW = 8;
const fancams = era.fancams ?? [];
// 끝난 활동인데 무대 영상이 하나도 없으면(일본 활동 등) 음방 칸을 숨긴다
const showStages = (era.kind === '컴백' || era.kind === 'NCT 단체') && (era.stages.length > 0 || fancams.length > 0 || (era.kind === '컴백' && era.status !== '종료'));
const relatedBy = ['OST', '예고·클립', '현장·인터뷰', '기타'].map((name) => ({ name, videos: (era.related ?? []).filter((v) => v.group === name) })).filter((g) => g.videos.length);
// 일정 묶음: 묶음 안 첫 일정 날짜 순, 다가오는 일정이 있으면 펼침
const groupNames = [...new Set(era.schedule.map((s) => s.group))];
const schedGroups = groupNames
  .map((name) => {
    const items = era.schedule.filter((s) => s.group === name);
    return { name, items, upcoming: items.some((s) => (s.endDate ?? s.date) >= today) };
  })
  .sort((a, b) => Number(b.upcoming) - Number(a.upcoming) || a.items[0].date.localeCompare(b.items[0].date));
const ownBy = (era.ownGroups ?? []).map((g) => ({ name: g, videos: era.own.filter((v) => v.group === g) }));
const ownTitle = era.kind === '팬미팅' ? '팬미팅 영상' : era.kind === 'NCT 단체' ? 'NCT 단체 콘텐츠' : '자체 콘텐츠';
const shortGroups = ['챌린지', '멤버 쇼츠'].map((name) => ({ name, videos: (era.shorts ?? []).filter((v) => v.group === name) })).filter((g) => g.videos.length);
// 영상 제목 정리: 그룹 이름·공통 해시태그는 떼고, 남은 해시태그(#EXO #KAI 등)는 낱말로
// 공통 해시태그 = 그룹 이름·상위 그룹 이름·이 활동 키워드로 시작하는 태그 (#NCTDREAM, #NCTDREAM_BoogieWoogie, #BoogieWoogie …)
const cfg = await loadSite(Astro.locals);
const sq = (t: string) => t.normalize('NFKC').replace(/[^\p{L}\p{N}]+/gu, '').toLowerCase();
const eraCfg = cfg.eras.find((e) => e.id === id);
const commonRoots = [...cfg.group.nameVariants, ...cfg.group.parentNames, ...(eraCfg?.keywords ?? []), eraCfg?.title ?? '', 'shorts'].map(sq).filter(Boolean);
const isCommonTag = (w: string) => commonRoots.some((r) => sq(w).startsWith(r));
const GROUP_RE = groupNameRe(cfg);
const short = (t: string) =>
  t.split(/\s+/).filter((w) => !(w.startsWith('#') && isCommonTag(w))).map((w) => (w.startsWith('#') ? w.slice(1) : w)).join(' ')
    .replace(GROUP_RE, '').replace(/\s{2,}/g, ' ').replace(/^[\s|·-]+|[\s|·-]+$/g, '').trim() || t;
// 응원법 게임: 공개 채보 중 이 활동의 타이틀곡·활동 이름·키워드와 제목이 같은 곡
const eraNames = new Set([era.titleSong, era.title, ...era.keys].filter((x): x is string => Boolean(x)).map(sq));
const fanchants = (await readIndex(Astro.locals.runtime?.env?.REPORTS).catch(() => [])).filter((f) => f.verified && eraNames.has(sq(f.title)));
---
<Base title={era.title} current="archive">
  <nav class="crumbs wrap" aria-label="경로">
    <a href="/archive/">아카이브</a><span>/</span><span>{era.from.slice(0, 4)}</span><span>/</span><b>{era.title}</b>
    <div class="jump">
      <a href="#timeline">타임라인</a><a href="#schedule">일정</a>{era.official.length > 0 && <a href="#official">공식 영상</a>}{showStages && <a href="#stages">음방 무대</a>}{relatedBy.length > 0 && <a href="#related">관련 영상</a>}{era.own.length > 0 && <a href="#own">{ownTitle}</a>}{(era.shorts ?? []).length > 0 && <a href="#shorts">쇼츠</a>}{era.outside.length > 0 && <a href="#outside">외부 콘텐츠</a>}{fanchants.length > 0 && <a href="#fanchant">응원법</a>}
    </div>
  </nav>
  {(era.guide ?? []).length > 0 && <nav class="era-tabs wrap" aria-label="활동 보기">
    <a href={`/archive/${era.id}/`} aria-current="page">활동 정보</a>
    <a href={`/archive/${era.id}/guide/`}>활동 가이드 <span>{era.guide!.length}</span></a>
  </nav>}

  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-cover"><Cover title={era.title} sub={era.subtitle} cover={era.cover} size="lg" image={era.thumb} /></div>
      <div class="hero-body">
        <div class="tags">
          <span class="tag lime">{era.kind}</span>
          {era.status === '활동 중' && <span class="tag live">활동 중</span>}
          {era.status === '종료' && <span class="tag">종료</span>}
        </div>
        <h1>{era.title}</h1>
        <p class="lead">{era.subtitle ? `${era.subtitle} · ` : ''}{era.titleSong ? <>타이틀곡 <b>{era.titleSong}</b></> : era.keys.filter((k) => k !== era.title).slice(0, 3).join(' · ')}</p>
        <dl class="facts">
          {era.release && <div><dt>발매일</dt><dd>{ymd(era.release)}</dd></div>}
          <div><dt>기간</dt><dd>{era.from.slice(0, 4) === era.to.slice(0, 4) ? `${md(era.from)} – ${md(era.to)}` : `${ymd(era.from)} – ${ymd(era.to)}`}</dd></div>
          <div><dt>{era.owner.scope === '단체' ? '함께' : era.owner.scope}</dt><dd>{era.owner.label}</dd></div>
        </dl>
        <p class="counts">
          <span><b>{era.counts.official}</b> 공식 영상</span><span><b>{era.counts.stages}</b> 음방 무대</span>{(era.counts.fancams ?? 0) > 0 && <span><b>{era.counts.fancams}</b> 직캠</span>}
          <span><b>{era.counts.own}</b> {era.kind === 'NCT 단체' ? ownTitle : '자체 콘텐츠'}</span><span><b>{era.counts.shorts ?? 0}</b> 쇼츠</span><span><b>{era.counts.outside}</b> 외부 콘텐츠</span>
          <a href="/">일정 {era.counts.events}개 보기 →</a>
        </p>
        {fanchants.map((f, i) => (
          <div class="era-fanchant" id={i === 0 ? 'fanchant' : undefined}>
            <span class="era-fanchant-label">응원법 게임</span>
            <b>{f.title}</b>
            <span class="era-fanchant-meta">노트 {f.noteCount} · {f.difficultyLabel}</span>
            <span class="era-fanchant-go">
              <a class="is-main" href={`/game/play?song=${f.songId}&mode=step1`}>응원법 연습하기</a>
              {f.hasMv && <a href={`/game/play?song=${f.songId}&mode=live`}>실전</a>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="light" id="timeline">
    <div class="wrap">
      <p class="eyebrow">TIMELINE</p>
      <div class="section-head"><h2>활동 타임라인</h2></div>
      <ol class="timeline">
        {era.timeline.map((m) => (
          <li class={m.date <= today ? 'done' : ''}>
            <span class="tl-date">{md(m.date)}</span>
            <span class="tl-dot"></span>
            <b>{m.label}</b>
            <small>{m.sub}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="light" id="schedule">
    <div class="wrap">
      <p class="eyebrow">DATES</p>
      <div class="section-head"><h2>일정</h2><span class="note">눌러서 펼쳐 보세요</span></div>
      <div class="sched-groups">
        {schedGroups.map((g) => (
          <details class="card sched" open={g.upcoming}>
            <summary>
              <b>{g.name}</b>
              <span class="sg-meta">{g.items.length}개 · {md(g.items[0].date)}{g.items.length > 1 ? ` – ${md(g.items.at(-1)!.endDate ?? g.items.at(-1)!.date)}` : ''}</span>
              {g.upcoming && <span class="sg-up">다가오는 일정</span>}
            </summary>
            {g.items.map((s) => (
              <div class={`sched-row${(s.endDate ?? s.date) < today ? ' past' : ''}`}>
                <span class="sd">{ymd(s.date)}{s.endDate && s.endDate !== s.date ? ` – ${md(s.endDate)}` : ''}</span>
                <span class="st">{s.time ?? ''}</span>
                <span class="sk"><span class="dot" style={`--c:var(--k-${s.kind.replace(/\s/g, '')})`}></span>{s.kind}</span>
                <span class="sn">{s.step.includes(s.title) ? s.step : <>{s.title} <em>· {s.step}</em></>}</span>
                {s.url && <a class="sl" href={s.url} target="_blank" rel="noopener">출처 ↗</a>}
              </div>
            ))}
          </details>
        ))}
      </div>
    </div>
  </section>

  {era.official.length > 0 && <section class="dark" id="official">
    <div class="wrap">
      <p class="eyebrow">OFFICIAL</p>
      <div class="section-head"><h2>뮤비·공식 영상</h2><span class="note">공식 채널의 뮤직비디오·티저·비하인드</span></div>
      <div class="grid g5">
        {era.official.map((v) => (
          <a class="vcard" href={v.url} target="_blank" rel="noopener">
            <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
            <b>{short(v.title)}</b><small>{ymd(v.date)}</small>
          </a>
        ))}
      </div>
    </div>
  </section>}

  {relatedBy.length > 0 && <section class="dark" id="related">
    <div class="wrap">
      <p class="eyebrow">RELATED</p>
      <div class="section-head"><h2>관련 영상</h2><span class="note">{relatedBy.map((g) => `${g.name} ${g.videos.length}`).join(' · ')}</span></div>
      {relatedBy.map((g) => (
        <div class="own-group">
          <h3>{g.name} <span>{g.videos.length}</span></h3>
          <div class="grid g4">
            {g.videos.map((v) => (
              <a class="vcard" href={v.url} target="_blank" rel="noopener">
                <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
                <b>{short(v.title)}</b><small>{v.channel} · {ymd(v.date)}</small>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>}

  {showStages && <section class="light" id="stages">
    <div class="wrap">
      <p class="eyebrow">MUSIC SHOWS</p>
      <div class="section-head"><h2>음방 무대</h2><span class="note">방송사 공식 채널 무대 영상</span></div>
      {era.stages.length === 0 && fancams.length === 0 ? <p class="empty-note">아직 올라온 무대 영상이 없어요.</p> : era.stages.map((s) => (
        <div class="card stage-group">
          <div class="stage-head"><b>{s.program}</b><span>{s.videos.length}개</span></div>
          <div class="grid g4">
            {s.videos.slice(0, STAGE_PREVIEW).map((v) => (
              <a class="vcard light-card" href={v.url} target="_blank" rel="noopener">
                <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
                <b>{short(v.title).slice(0, 40)}</b><small>{ymd(v.date)}</small>
              </a>
            ))}
          </div>
          {s.videos.length > STAGE_PREVIEW && (
            <details class="more-list"><summary>{s.videos.length - STAGE_PREVIEW}개 더 보기</summary>
              <div class="grid g4">
                {s.videos.slice(STAGE_PREVIEW).map((v) => (
                  <a class="vcard light-card" href={v.url} target="_blank" rel="noopener">
                <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
                <b>{short(v.title).slice(0, 40)}</b><small>{ymd(v.date)}</small>
              </a>
                ))}
              </div>
            </details>
          )}
        </div>
      ))}
      {fancams.length > 0 && (
        <div class="card stage-group fancams" data-fancams>
          <div class="stage-head"><b>직캠</b><span>멤버를 골라 보세요</span></div>
          <nav class="fc-tabs" role="tablist">
            {fancams.map((f, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={f.member}>{f.member} <span>{f.videos.length}</span></button>)}
          </nav>
          {fancams.map((f, i) => (
            <div class="fc-panel" data-panel={f.member} hidden={i !== 0}>
              <div class="grid g4">
                {f.videos.map((v) => (
                  <a class="vcard light-card" href={v.url} target="_blank" rel="noopener">
                <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
                <b>{short(v.title).slice(0, 40)}</b><small>{ymd(v.date)}</small>
              </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>}

  {era.own.length > 0 && <section class="dark" id="own">
    <div class="wrap">
      <p class="eyebrow">{era.kind === '팬미팅' ? 'FAN MEETING' : era.kind === 'NCT 단체' ? 'NCT' : 'ORIGINAL'}</p>
      <div class="section-head"><h2>{ownTitle}</h2><span class="note">{ownBy.map((g) => `${g.name} ${g.videos.length}`).join(' · ')}</span></div>
      <nav class="own-jump">{ownBy.map((g) => <a href={`#own-${g.name}`}>{g.name} <span>{g.videos.length}</span></a>)}</nav>
      {ownBy.map((g) => (
        <div class="own-group" id={`own-${g.name}`}>
          <h3>{g.name} <span>{g.videos.length}</span></h3>
          <div class="grid g4">
            {g.videos.slice(0, OWN_PREVIEW).map((v) => (
              <a class="vcard" href={v.url} target="_blank" rel="noopener">
                <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
                <b>{short(v.title)}</b><small>{ymd(v.date)}</small>
              </a>
            ))}
          </div>
          {g.videos.length > OWN_PREVIEW && (
            <details class="more-list">
              <summary>{g.videos.length - OWN_PREVIEW}개 더 보기</summary>
              <div class="grid g4">
                {g.videos.slice(OWN_PREVIEW).map((v) => (
                  <a class="vcard" href={v.url} target="_blank" rel="noopener">
                    <span class="thumb"><img src={v.thumb} alt="" loading="lazy" /></span>
                    <b>{short(v.title)}</b><small>{ymd(v.date)}</small>
                  </a>
                ))}
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </section>}

  {(era.shorts ?? []).length > 0 && <section class="dark shorts" id="shorts">
    <div class="wrap">
      <p class="eyebrow">SHORTS</p>
      <div class="section-head"><h2>쇼츠</h2><span class="note">{shortGroups.map((g) => `${g.name} ${g.videos.length}`).join(' · ')}</span></div>
      {shortGroups.map((g) => (
        <div class="own-group">
          <h3>{g.name} <span>{g.videos.length}</span></h3>
          <div class="short-grid">
            {g.videos.slice(0, 12).map((v) => (
              <a class="scard" href={v.url} target="_blank" rel="noopener">
                <span class="sthumb"><img src={v.thumb.replace('mqdefault', 'hqdefault')} alt="" loading="lazy" /></span>
                <b>{short(v.title)}</b><small>{md(v.date)}</small>
              </a>
            ))}
          </div>
          {g.videos.length > 12 && (
            <details class="more-list"><summary>{g.videos.length - 12}개 더 보기</summary>
              <div class="short-grid">
                {g.videos.slice(12).map((v) => (
                  <a class="scard" href={v.url} target="_blank" rel="noopener">
                    <span class="sthumb"><img src={v.thumb.replace('mqdefault', 'hqdefault')} alt="" loading="lazy" /></span>
                    <b>{short(v.title)}</b><small>{md(v.date)}</small>
                  </a>
                ))}
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </section>}

  {era.outside.length > 0 && <section class="dark deep" id="outside">
    <div class="wrap">
      <p class="eyebrow">OUTSIDE</p>
      <div class="section-head"><h2>활동 기간 중 출연</h2><span class="note">예능·유튜브·라디오</span></div>
      <div class="grid g5">
        {era.outside.map((o) => (
          <a class="vcard" href={o.url} target="_blank" rel="noopener">
            <span class={`thumb${o.thumb ? '' : ' no-thumb'}`}>{o.thumb ? <img src={o.thumb} alt="" loading="lazy" /> : <em>{o.title.slice(0, 18)}</em>}</span>
            <b>{o.title}</b>
            <small>{o.sub} · {o.members.length ? o.members.join('·') : '단체'} · {md(o.date)}</small>
          </a>
        ))}
      </div>
    </div>
  </section>}
  {(era.news ?? []).length > 0 && <section class="light" id="news">
    <div class="wrap">
      <p class="eyebrow">NEWS</p>
      <div class="section-head"><h2>기사</h2><span class="note">관련 기사 {era.news!.length}개</span></div>
      <div class="card news-list">
        {era.news!.map((n) => (
          <a class="news-row" href={n.url} target="_blank" rel="noopener"><span>{ymd(n.date)}</span><b>{n.title}</b><small>{n.publisher}</small></a>
        ))}
      </div>
    </div>
  </section>}
</Base>

<script>
  // 직캠 멤버 탭
  for (const box of document.querySelectorAll<HTMLElement>('[data-fancams]')) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...box.querySelectorAll<HTMLElement>('[data-panel]')];
    for (const t of tabs) t.addEventListener('click', () => {
      for (const x of tabs) x.setAttribute('aria-selected', String(x === t));
      for (const p of panels) p.hidden = p.dataset.panel !== t.dataset.tab;
    });
  }
</script>
