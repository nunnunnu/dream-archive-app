---
/**
 * 활동 가이드: 팬이 해야 할 일(투표·앨범 구매·응모·예매·라디오)을 마감 순으로.
 * 데이터는 수집기가 활동 일정에서 뽑은 guide (공식 공지·기사 = 자동 수집, 팬 제보 = 제보).
 * 체크 상태는 이 기기(localStorage)에만 저장한다.
 */
import Base from '../../../layouts/Base.astro';
import { loadPublic, md, type EraPage, type GuideItem, type GuideType } from '../../../lib/data';
import '../../../styles/era.css';
import '../../../styles/guide.css';

const { id } = Astro.params;
const found = await loadPublic<EraPage | null>(Astro.locals, `eras/${id}.json`, null);
if (!found) return new Response('없는 활동이에요', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
const era = found;
const items = era.guide ?? [];

const DAY = 864e5;
const kstNow = new Date(Date.now() + 9 * 3600 * 1000);
const today = kstNow.toISOString().slice(0, 10);
const addDays = (d: string, n: number) => new Date(Date.parse(d) + n * DAY).toISOString().slice(0, 10);
const tomorrow = addDays(today, 1);
const WD = ['일', '월', '화', '수', '목', '금', '토'];
const wd = (d: string) => WD[new Date(`${d}T00:00:00Z`).getUTCDay()];
const dDay = (d: string) => Math.round((Date.parse(d) - Date.parse(today)) / DAY);

// 마감을 모르는 항목(사전투표 시작 등)은 시작부터 사흘 동안만 "할 일"로 본다
const endOf = (g: GuideItem) => (g.openEnded ? addDays(g.start, 2) : g.due);
const isNow = (g: GuideItem) => g.start <= today && endOf(g) >= today;
const isPast = (g: GuideItem) => endOf(g) < today;
const byDue = (a: GuideItem, b: GuideItem) => `${endOf(a)} ${a.dueTime ?? '99'}`.localeCompare(`${endOf(b)} ${b.dueTime ?? '99'}`);

const now = items.filter(isNow).sort(byDue);
const dueSoon = items.filter((g) => !isPast(g) && !g.openEnded && (g.due === today || g.due === tomorrow)).length;

const TYPES: { type: GuideType; key: string; label: string; eyebrow: string; action: string; note: string }[] = [
  { type: '투표', key: 'vote', label: '투표', eyebrow: 'VOTE', action: '투표 안내', note: '음악방송 사전투표·시상식 투표' },
  { type: '앨범 구매', key: 'album', label: '앨범 구매', eyebrow: 'ALBUM', action: '구매 안내', note: '판매·특전·구매 취소 마감' },
  { type: '응모·신청', key: 'apply', label: '응모', eyebrow: 'APPLY', action: '응모 안내', note: '팬사인회·영상통화·사전녹화·이벤트 응모와 당첨 확인' },
  { type: '예매', key: 'ticket', label: '예매', eyebrow: 'TICKET', action: '예매 안내', note: '팬클럽 인증·선예매·일반 예매' },
  { type: '라디오', key: 'radio', label: '라디오', eyebrow: 'RADIO', action: '신청 안내', note: '라디오 출연·사연 신청' },
];
const sections = TYPES.map((t) => {
  const list = items.filter((g) => g.type === t.type);
  return { ...t, list, open: list.filter((g) => !isPast(g)).sort(byDue), past: list.filter(isPast).sort(byDue).reverse() };
}).filter((s) => s.list.length);

// 이번 주(일~토) 막대 캘린더
const sunday = addDays(today, -new Date(`${today}T00:00:00Z`).getUTCDay());
const week = Array.from({ length: 7 }, (_, i) => addDays(sunday, i));
const bars = items
  .filter((g) => g.start <= week[6] && endOf(g) >= week[0])
  .sort((a, b) => a.start.localeCompare(b.start) || byDue(a, b))
  .map((g) => {
    const s = Math.max(0, week.indexOf(g.start < week[0] ? week[0] : g.start));
    const e = week.indexOf(endOf(g) > week[6] ? week[6] : endOf(g));
    return { g, col: s + 1, span: Math.max(1, e - s + 1) };
  });
const typeKey = (t: GuideType) => TYPES.find((x) => x.type === t)!.key;

const dueLabel = (g: GuideItem) => {
  if (g.openEnded) return { text: g.start === today ? `오늘 ${g.startTime ?? ''} 시작`.trim() : `${md(g.start)} 시작`, cls: 'soft' };
  if (isPast(g)) return { text: '끝남', cls: 'done' };
  const n = dDay(g.due);
  if (n === 0) return { text: `오늘 ${g.dueTime ?? '23:59'}`, cls: 'today' };
  return { text: `D-${n}`, cls: n <= 2 ? 'warn' : 'soft' };
};
const period = (g: GuideItem) =>
  g.openEnded ? `${md(g.start)}(${wd(g.start)}) ${g.startTime ?? ''} 시작 · 마감 미정`
  : g.start === g.due ? `${md(g.due)}(${wd(g.due)}) ${g.dueTime ?? ''}`.trim()
  : `${md(g.start)}(${wd(g.start)}) ${g.startTime ?? ''} – ${md(g.due)}(${wd(g.due)}) ${g.dueTime ?? ''}`.replace(/\s+/g, ' ').trim();
const live = era.status === '활동 중';
---
<Base title={`${era.title} 활동 가이드`} current="archive">
  <nav class="crumbs wrap" aria-label="경로">
    <a href="/archive/">아카이브</a><span>/</span><span>{era.from.slice(0, 4)}</span><span>/</span><a href={`/archive/${era.id}/`}>{era.title}</a><span>/</span><b>활동 가이드</b>
    <div class="jump"><a href="#today">오늘 할 일</a>{sections.length > 0 && <a href={`#${sections[0].key}`}>종류별 일정</a>}</div>
  </nav>
  <nav class="era-tabs wrap" aria-label="활동 보기">
    <a href={`/archive/${era.id}/`}>활동 정보</a>
    <a href={`/archive/${era.id}/guide/`} aria-current="page">활동 가이드 <span>{items.length}</span></a>
  </nav>

  <section class="g-hero">
    <div class="wrap g-hero-in">
      <div>
        <div class="tags">
          <span class="tag lime">{era.kind}</span>
          {live && <span class="tag live">활동 중</span>}
          {era.status === '종료' && <span class="tag">종료</span>}
        </div>
        <h1>{era.title}<br /><em>활동 가이드</em></h1>
        <p class="g-lead">투표·앨범 구매·응모·예매·라디오 마감을 마감이 빠른 순서로 모았어요.</p>
      </div>
      <div class="g-stats">
        <div><b>{dueSoon}</b><small>오늘·내일 마감</small></div>
        <div><b>{now.length}</b><small>오늘 할 일</small></div>
        <div><b>{items.length}</b><small>전체 할 일</small></div>
      </div>
    </div>
  </section>

  {items.length === 0 ? (
    <section class="light"><div class="wrap"><p class="empty-note g-empty">이 활동에는 아직 팬이 할 일(투표·구매·응모·예매) 일정이 없어요. 알고 있는 일정이 있으면 <a href="/report/">제보</a>해 주세요.</p></div></section>
  ) : (
  <>
  <section class="light" id="today">
    <div class="wrap">
      <p class="eyebrow">TODAY</p>
      <div class="section-head"><h2>오늘 할 일</h2><span class="note">체크한 건 이 기기에만 남아요</span></div>
      <div class="g-today">
        <div class="card g-check" data-guide={era.id}>
          <div class="g-check-head">
            <b>오늘 할 일 체크리스트</b><span>{today.replaceAll('-', '.')} ({wd(today)})</span>
          </div>
          {now.length > 0 && <div class="g-progress"><span class="bar"><i data-bar style="width:0%"></i></span><b data-count>0 / {now.length} 완료</b><small>마감 빠른 순</small></div>}
          {now.length === 0 ? (
            <p class="g-none">오늘 할 일이 없어요.{(() => { const next = items.filter((g) => g.start > today).sort((a, b) => a.start.localeCompare(b.start))[0]; return next ? ` 다음 할 일은 ${md(next.start)}(${wd(next.start)}) ${next.title.slice(0, 40)}이에요.` : ''; })()}</p>
          ) : now.map((g) => {
            const d = dueLabel(g);
            return (
              <label class="g-row" data-item={g.id}>
                <input type="checkbox" />
                <span class="g-main">
                  <b><i class={`g-dot t-${typeKey(g.type)}`}></i>{g.title}</b>
                  <span class="chips"><span class="chip">{g.source}</span>{!g.auto && <span class="chip fan">팬 제보</span>}{g.check && <span class="chip warn">확인 중</span>}</span>
                </span>
                <span class="g-due"><span class={`badge ${d.cls}`}>{d.text}</span>{g.url && <a href={g.url} target="_blank" rel="noopener">공지 ↗</a>}</span>
              </label>
            );
          })}
        </div>
        <aside class="g-side">
          <div class="card g-week">
            <b>이번 주 마감은 캘린더에도 있어요</b>
            <small>체크리스트의 마감일은 일정 캘린더에도 표시돼요.</small>
            <div class="wk">
              {week.map((d) => <span class={`wk-h${d === today ? ' on' : ''}${wd(d) === '일' ? ' sun' : wd(d) === '토' ? ' sat' : ''}`}><em>{wd(d)}</em><i>{Number(d.slice(8))}</i></span>)}
              {bars.map((b) => <span class={`wk-bar t-${typeKey(b.g.type)}`} style={`grid-column:${b.col} / span ${b.span}`} title={`${b.g.title} · ${period(b.g)}`}>{b.g.title.replace(/^NCT DREAM\s*/, '').slice(0, 18)}</span>)}
              {bars.length === 0 && <span class="wk-empty">이번 주 마감이 없어요</span>}
            </div>
            <div class="legend">{TYPES.filter((t) => items.some((g) => g.type === t.type)).map((t) => <span><i class={`g-dot t-${t.key}`}></i>{t.label}</span>)}</div>
            <a class="wk-link" href="/">일정 캘린더에서 전체 보기 <span>{md(week[0])} – {md(week[6])}</span></a>
          </div>
          <div class="card g-info"><b>팬 제보</b> 표시가 있는 일정은 팬이 알려 준 일정이에요. 공지 링크로 한 번 더 확인해 주세요.</div>
        </aside>
      </div>

      <nav class="g-filter" aria-label="종류별 일정">
        <a href="#streaming">스밍 <span>제보</span></a>
        {sections.map((s) => <a href={`#${s.key}`}>{s.label} <span>{s.open.length}</span></a>)}
      </nav>
    </div>
  </section>

  <section class="light" id="streaming">
    <div class="wrap">
      <p class="eyebrow">STREAMING</p>
      <div class="section-head"><h2>스밍 가이드</h2><span class="note">스밍 리스트·총공 시간은 팬 연합이 정해요</span></div>
      <div class="card g-stream">
        <div>
          <b>스밍 가이드는 팬 연합이 SNS로 알려요</b>
          <p>스밍 리스트나 총공 시간을 알고 있다면 제보해 주세요. 확인하고 여기에 올릴게요.</p>
        </div>
        <a class="g-btn" href="/report/">스밍 가이드 제보하기</a>
      </div>
    </div>
  </section>

  {sections.map((s) => (
    <section class="light" id={s.key}>
      <div class="wrap">
        <p class="eyebrow">{s.eyebrow}</p>
        <div class="section-head"><h2>{s.label} 일정</h2><span class="note">{s.note}</span></div>
        {s.open.length === 0 && <p class="empty-note">남은 {s.label} 일정이 없어요.</p>}
        <div class="g-list">
          {s.open.map((g) => {
            const d = dueLabel(g);
            const key = g.openEnded ? g.start : g.due;
            return (
              <div class={`card g-item${isNow(g) && (g.openEnded || dDay(g.due) <= 2) ? ' hot' : ''}`}>
                <div class="g-date"><b>{md(key)}</b><small>{wd(key)} {g.openEnded ? '시작' : '마감'}</small></div>
                <div class="g-body">
                  <b>{g.title}</b>
                  <span class="chips"><span class={`badge ${d.cls}`}>{d.text}</span><span class="chip">{g.source}</span>{!g.auto && <span class="chip fan">팬 제보</span>}{g.check && <span class="chip warn">확인 중</span>}</span>
                </div>
                <div class="g-when"><small>기간</small><b>{period(g)}</b></div>
                {g.url ? <a class="g-btn" href={g.url} target="_blank" rel="noopener">{s.action} ↗</a> : <span></span>}
              </div>
            );
          })}
        </div>
        {s.past.length > 0 && (
          <details class="more-list g-past"><summary>지난 {s.label} 일정 {s.past.length}개</summary>
            <div class="g-list">
              {s.past.map((g) => (
                <div class="card g-item past">
                  <div class="g-date"><b>{md(g.openEnded ? g.start : g.due)}</b><small>{wd(g.openEnded ? g.start : g.due)}</small></div>
                  <div class="g-body"><b>{g.title}</b><span class="chips"><span class="chip">{g.source}</span></span></div>
                  <div class="g-when"><small>기간</small><b>{period(g)}</b></div>
                  {g.url ? <a class="g-btn ghost" href={g.url} target="_blank" rel="noopener">공지 ↗</a> : <span></span>}
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    </section>
  ))}
  </>
  )}

</Base>

<script>
  // 체크 상태: 이 기기에만 (localStorage, 막혀 있으면 저장 없이 동작)
  for (const box of document.querySelectorAll<HTMLElement>('[data-guide]')) {
    const key = `guide:${box.dataset.guide}`;
    let done = new Set<string>();
    try { done = new Set(JSON.parse(localStorage.getItem(key) ?? '[]')); } catch {}
    const rows = [...box.querySelectorAll<HTMLElement>('[data-item]')];
    const bar = box.querySelector<HTMLElement>('[data-bar]');
    const count = box.querySelector<HTMLElement>('[data-count]');
    const render = () => {
      const n = rows.filter((r) => done.has(r.dataset.item!)).length;
      if (bar) bar.style.width = `${rows.length ? (n / rows.length) * 100 : 0}%`;
      if (count) count.textContent = `${n} / ${rows.length} 완료`;
      for (const r of rows) r.classList.toggle('checked', done.has(r.dataset.item!));
    };
    for (const r of rows) {
      const cb = r.querySelector<HTMLInputElement>('input')!;
      cb.checked = done.has(r.dataset.item!);
      cb.addEventListener('change', () => {
        cb.checked ? done.add(r.dataset.item!) : done.delete(r.dataset.item!);
        try { localStorage.setItem(key, JSON.stringify([...done])); } catch {}
        render();
      });
    }
    render();
  }
</script>
