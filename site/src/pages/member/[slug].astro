---
/**
 * 멤버 문서 (/member/jeno/, 그룹은 /member/nctdream/)
 *  표지 배너(사진·이름·생일) + 프로필 표 → 탭(타임라인·활동·유닛/솔로·기록·관련 문서)
 *  - 타임라인: 연도마다 카드, 활동마다 표지·종류·이름·바로가기
 *  - 기록: 예능·자컨 표, 방송 출연, 화보·광고, 최근 소식
 * 프로필 표의 본명·소속은 설정(공개된 사실), 포지션은 운영자가 직접 적는다. 나머지는 자동 수집.
 */
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { loadPublic, ymd, type EraSummary } from '../../lib/data';
import { colorOf, daysUntil, EMPTY_MEMBERS, thumbs, todayKst, type MembersData } from '../../lib/members';

const { slug } = Astro.params;
const [data, { eras }] = await Promise.all([
  loadPublic<MembersData>(Astro.locals, 'members.json', EMPTY_MEMBERS),
  loadPublic<{ eras: EraSummary[] }>(Astro.locals, 'eras.json', { eras: [] }),
]);
const all = [data.group, ...data.members];
const m = all.find((x) => x.slug === slug);
if (!m) return new Response('없는 문서예요', { status: 404 });
const isGroup = m.kind === '그룹';
const color = colorOf(m);
const eraById = new Map(eras.map((e) => [e.id, e]));
const bigEras = m.eras.map((id) => eraById.get(id)).filter((e): e is EraSummary => Boolean(e));
const nextDay = m.birthday ? daysUntil(m.birthday) : m.debut ? daysUntil(m.debut.slice(5)) : null;
const dayLabel = isGroup ? '데뷔 기념일' : '생일';
const debutYear = m.debut?.slice(0, 4);
const thisYear = todayKst().slice(0, 4);
const KIND_SHORT: Record<string, string> = { 컴백: '컴백', '콘서트·투어': '투어', 팬미팅: '팬미팅', 드라마: '드라마', 시상식: '시상식', 페스티벌: '페스티벌', 팝업: '팝업', 활동: '활동', 예능: '예능' };
const GO: Record<string, string> = { 컴백: '컴백 보기', '콘서트·투어': '투어 보기', 팬미팅: '팬미팅 보기', 드라마: '드라마 보기' };
const photo = m.photo ? thumbs(m.photo.thumb) : null;
// 유닛·솔로: 소속 그룹 + 이 멤버(들)만의 활동
const ownActs = m.timeline.flatMap((y) => y.items).filter((it) => it.owner !== '단체');
const unitActs = (g: string) => ownActs.filter((a) => a.owner === g || (a.owner.includes('·') && g !== m.groups[0]));
const soloActs = ownActs.filter((a) => a.owner === m.name);
const TABS = [['timeline', '타임라인'], ['activities', '활동'], ...(isGroup ? [] : [['units', '유닛·솔로']]), ['records', '기록'], ['related', '관련 문서']] as [string, string][];
const total = m.timeline.reduce((n, y) => n + y.items.length, 0);
---
<Base title={`${m.name} 문서`} current="archive">
  <main class="wrap mdoc" style={`--from:${color.from};--to:${color.to};--dot:${color.dot}`}>
    <p class="crumbs"><a href="/archive/">아카이브</a><span>/</span>{isGroup ? '그룹 문서' : '멤버 문서'}<span>/</span><b>{m.name}</b></p>

    <section class="banner">
      {photo && <img class="banner-img" style={`object-position:${Math.min(100, (m.photo?.focus ?? 50) + 20)}% 25%`} src={photo.big} alt="" loading="eager" referrerpolicy="no-referrer" onerror={`if(!this.dataset.hq){this.dataset.hq=1;this.src='${photo.hq}';this.classList.add('lb')}else{this.remove()}`} />}
      <span class="banner-initial">{(m.en || m.name).slice(0, 1)}</span>
      
      <div class="banner-name">
        <h1>{m.name}</h1>
        <p>{!isGroup && <b>{m.en}</b>}<i></i>{m.born ? <span class="chip-day">{ymd(m.born)}</span> : m.debut ? <span class="chip-day">데뷔 {ymd(m.debut)}</span> : null}</p>
      </div>
      {m.photo && <a class="banner-src" href={m.photo.url} target="_blank" rel="noopener">사진 출처 ↗</a>}
    </section>

    <div class="intro">
      <div class="intro-text">
        {isGroup
          ? <p><b>{m.name}</b>는 {debutYear}년 데뷔한 그룹이에요. 그룹 활동(컴백·투어·팬미팅·예능)을 한 문서에 모았어요.</p>
          : <p><b>{m.name}({m.en})</b>는 {m.groups.join(', ')}의 멤버예요.{debutYear && ` ${debutYear}년 데뷔 이후 그룹 활동과 개인 활동을 이어 왔어요.`}</p>}
        
        <nav class="mchips" aria-label="다른 문서">
          <a href="/member/nctdream/" aria-current={isGroup ? 'page' : undefined}><i style={`background:${colorOf(data.group).dot}`}></i>그룹</a>
          {data.members.map((x) => <a href={`/member/${x.slug}/`} aria-current={x.slug === m.slug ? 'page' : undefined}><i style={`background:${colorOf(x).dot}`}></i>{x.name}</a>)}
        </nav>
        <div class="actions">
          {nextDay && <span class={`dday${nextDay.days === 0 ? ' today' : ''}`}>{dayLabel} <b>{nextDay.days === 0 ? '오늘' : `D-${nextDay.days}`}</b> <em>{ymd(nextDay.date)}</em></span>}
          <a class="ics" href={`/calendar/${isGroup ? 'group' : m.slug}.ics`}>캘린더에 추가</a>
        </div>
      </div>
      <table class="infobox">
        <caption><span>프로필</span></caption>
        <tbody>
          {isGroup ? (
            <>
              <tr><th>데뷔</th><td>{m.debut ? ymd(m.debut) : '-'}</td></tr>
              <tr><th>멤버</th><td>{data.members.map((x) => x.name).join(' · ')}</td></tr>
              <tr><th>기록</th><td>활동 {total}개</td></tr>
            </>
          ) : (
            <>
              <tr><th>본명</th><td>{m.realName ?? '-'}</td></tr>
              <tr><th>포지션</th><td>{m.position ?? '-'}</td></tr>
              <tr><th>생일</th><td>{m.born ? ymd(m.born) : m.birthday ? m.birthday.replace('-', '.') : '-'}</td></tr>
              <tr><th>소속</th><td>{m.groups.join(', ')}</td></tr>
            </>
          )}
        </tbody>
      </table>
    </div>

    <nav class="tabs" aria-label="문서 목차">{TABS.map(([id, label], i) => <a href={`#${id}`} class={i === 0 ? 'on' : ''}>{label}</a>)}</nav>

    <section id="timeline" class="sec">
      <div class="sec-head"><h2>타임라인</h2><span class="auto">활동 {total}개</span></div>
      <p class="sec-sub">공식 활동을 연도별로 모았어요. 누르면 그 활동 문서로 가요.</p>
      {m.timeline.map((y) => (
        <div class={`ycard${y.year === thisYear ? ' now' : ''}`}>
          <div class="ycard-head"><h3>{y.year}</h3>{y.year === thisYear && <span class="k k-컴백">올해</span>}<small>{y.items.length}건</small></div>
          <ul>{y.items.map((it) => {
            const e = eraById.get(it.eraId);
            return (
              <li><a href={`/archive/${it.eraId}/`}>
                <span class="yc-cover">{e ? <Cover title={e.title} cover={e.cover} image={e.thumb} /> : <span class="yc-blank"></span>}</span>
                <span class="yc-date">{Number(it.date.slice(5, 7))}월</span>
                <span class={`k k-${it.kind}`}>{KIND_SHORT[it.kind] ?? it.kind}</span>
                <b>{it.title}</b>{it.owner !== '단체' && <em>{it.owner}</em>}
                <span class="yc-go">{GO[it.kind] ?? '자세히'} →</span>
              </a></li>
            );
          })}</ul>
        </div>
      ))}
      {!m.timeline.length && <p class="empty">아직 모은 활동이 없어요.</p>}
    </section>

    <section id="activities" class="sec">
      <div class="sec-head"><h2>활동</h2></div>
      <p class="sec-sub">컴백·투어·팬미팅을 표지로 모았어요.</p>
      <div class="era-row">
        {bigEras.map((e) => (
          <a class="era" href={`/archive/${e.id}/`}>
            <Cover title={e.title} sub={e.subtitle} cover={e.cover} image={e.thumb} />
            <b>{e.title}</b><small>{e.from.slice(0, 4)} · {KIND_SHORT[e.kind] ?? e.kind}</small>
          </a>
        ))}
      </div>
    </section>

    {!isGroup && (
      <section id="units" class="sec">
        <div class="sec-head"><h2>유닛·솔로</h2></div>
        <p class="sec-sub">소속 그룹과 유닛·개인 활동이에요.</p>
        <div class="unit-grid">
          {m.groups.map((g, i) => (
            <div class="unit">
              <span class={`unit-badge${i === 0 ? ' main' : ''}`}>{g}</span>
              <span><small>{i === 0 ? '그룹' : '유닛·그룹'}</small><b>{g}</b><em>{i === 0 ? `${debutYear} – 현재` : unitActs(g).length ? unitActs(g).map((a) => a.title).slice(0, 3).join(' · ') : '드림 활동 위주로 모았어요'}</em></span>
            </div>
          ))}
          <div class="unit">
            <span class="unit-badge solo">SOLO</span>
            <span><small>개인</small><b>솔로·개인 활동</b><em>{soloActs.length ? soloActs.map((a) => a.title).slice(0, 3).join(' · ') : '아직 모은 개인 활동이 없어요'}</em></span>
          </div>
        </div>
      </section>
    )}

    <section id="records" class="sec">
      <div class="sec-head"><h2>기록</h2></div>
      <p class="sec-sub">예능·자컨, 방송 출연, 화보·광고, 최근 소식이에요.</p>
      <h3 class="sub-h">예능·자컨</h3>
      {m.variety.length ? (
        <table class="tbl">
          <thead><tr><th>시리즈</th><th>종류</th><th>편수</th><th>최근</th></tr></thead>
          <tbody>{m.variety.map((v) => <tr><td><a href={`/series/${v.id}/`}>{v.name}</a></td><td>{v.type}</td><td>{v.count}편</td><td>{ymd(v.to)}</td></tr>)}</tbody>
        </table>
      ) : <p class="empty">아직 모은 예능·자컨이 없어요.</p>}
      {m.appearances.length > 0 && (
        <>
          <h3 class="sub-h">방송 출연</h3>
          <table class="tbl">
            <thead><tr><th>프로그램</th><th>내용</th><th>날짜</th><th>원문</th></tr></thead>
            <tbody>{m.appearances.map((a) => <tr><td>{a.title}</td><td>{a.step}</td><td>{ymd(a.date)}</td><td>{a.url && <a href={a.url} target="_blank" rel="noopener">원문 링크 ↗</a>}</td></tr>)}</tbody>
          </table>
        </>
      )}
      {m.pictorial.length > 0 && (
        <>
          <h3 class="sub-h">화보·광고</h3>
          <div class="pic-grid">
            {m.pictorial.map((p) => (
              <a class="pic" href={p.url} target="_blank" rel="noopener">
                <span class="pic-img">{p.image && <><img class="pic-bg" src={p.image} alt="" aria-hidden="true" loading="lazy" referrerpolicy="no-referrer" /><img class="pic-main" src={p.image} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.previousElementSibling?.remove(); this.remove()" /></>}<em>{p.publisher}</em></span>
                <b>{p.title}</b><small>{ymd(p.date)} · {p.topic}</small>
              </a>
            ))}
          </div>
          
        </>
      )}
      <h3 class="sub-h">최근 소식</h3>
      <ul class="news">
        {m.news.map((n) => (
          <li><a href={n.url} target="_blank" rel="noopener">
            <span class="nk">{n.topic ?? (n.type === 'weverse-notice' ? '공지' : n.type === 'sns' ? 'SNS' : '기사')}</span>
            <span class="nt"><b>{n.title}</b><small>{n.publisher ?? ''} · {ymd(n.date)}</small></span>
            {n.image && <img src={n.image} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}
          </a></li>
        ))}
      </ul>
      <a class="more" href={isGroup ? '/news/' : `/news/?member=${encodeURIComponent(m.name)}`}>소식 탭에서 더 보기 →</a>
    </section>

    <section id="related" class="sec">
      <div class="sec-head"><h2>관련 문서</h2></div>
      <div class="rel-grid">
        {bigEras.slice(0, 4).map((e) => (
          <a class="rel-card" href={`/archive/${e.id}/`}><Cover title={e.title} sub={e.subtitle} cover={e.cover} image={e.thumb} /><small>{KIND_SHORT[e.kind] ?? e.kind}</small><b>{e.title}</b></a>
        ))}
      </div>
      <p class="rel-members">다른 문서 {all.filter((x) => x.slug !== m.slug).map((x) => <a href={`/member/${x.slug}/`}><i style={`background:${colorOf(x).dot}`}></i>{x.kind === '그룹' ? '그룹' : x.name}</a>)}</p>
      <p class="note">이 문서에 빠진 게 있나요? <a href="/report/">제보</a></p>
    </section>
  </main>
</Base>

<script>
  // 탭: 지금 보는 칸 표시
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.tabs a')];
  const secs = tabs.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) for (const a of tabs) a.classList.toggle('on', a.getAttribute('href') === `#${e.target.id}`);
  }, { rootMargin: '-40% 0px -55% 0px' });
  for (const s of secs) io.observe(s);
</script>

<style>
  .mdoc { padding-bottom: 64px; }
  .crumbs { margin: 18px 0 12px; color: var(--sub); font-size: 12.5px; display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--text); font-weight: 700; text-decoration: none; }
  .crumbs b { color: var(--text); }
  .banner { position: relative; height: 300px; border-radius: 22px; overflow: hidden; background: linear-gradient(120deg, var(--from) 0%, var(--to) 100%); box-shadow: 0 20px 40px rgba(0,0,0,.14); }
  /* 배너 사진: 썸네일의 자막 쪽은 빼고 얼굴 쪽만 (좁게 + 얼굴 위치 쪽으로) */
  /* 배너 사진: 오른쪽 아래는 프로필 표가 겹쳐 올라가서, 그 왼쪽(가운데 오른쪽)에 둔다. 양옆은 흐리게 */
  .banner-img { position: absolute; right: 320px; top: 0; height: 100%; width: 34%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.4) 22%, #000 45%, #000 78%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.4) 22%, #000 45%, #000 78%, transparent 100%); }
  .banner-img.lb { transform: scale(1.34); transform-origin: center; }
  .banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, color-mix(in srgb, var(--from) 75%, transparent) 0%, transparent 55%); pointer-events: none; }
  .banner-initial { position: absolute; left: 26px; top: -6px; z-index: 1; color: rgba(255,255,255,.22); font-size: 190px; font-weight: 900; line-height: 1; letter-spacing: -.06em; }
  .banner-badge { position: absolute; right: 16px; top: 16px; z-index: 2; background: rgba(0,0,0,.55); color: #fff; font-size: 11px; font-weight: 700; padding: 6px 11px; border-radius: 999px; backdrop-filter: blur(6px); }
  .banner-name { position: absolute; left: 30px; bottom: 26px; z-index: 2; color: #fff; }
  .banner-name h1 { margin: 0; font-size: clamp(44px, 6vw, 64px); letter-spacing: -.05em; line-height: 1; text-shadow: 0 2px 18px rgba(0,0,0,.25); }
  .banner-name p { margin: 10px 0 0; display: flex; align-items: center; gap: 10px; }
  .banner-name p b { font-size: 13px; letter-spacing: .16em; }
  .banner-name p i { width: 10px; height: 10px; border-radius: 50%; background: var(--dot); box-shadow: 0 0 0 3px rgba(255,255,255,.35); }
  .chip-day { background: rgba(255,255,255,.92); color: #111; border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 800; }
  .banner-src { position: absolute; right: 336px; bottom: 12px; z-index: 2; color: rgba(255,255,255,.75); font-size: 10.5px; text-decoration: none; }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 32px; align-items: start; }
  .intro-text { padding-top: 22px; min-width: 0; }
  .intro-text p { margin: 0 0 10px; font-size: 15px; line-height: 1.75; }
  .intro-text .sub { color: var(--sub); font-size: 13px; }
  .infobox { margin-top: -70px; position: relative; z-index: 3; width: 100%; border-collapse: collapse; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 16px 36px rgba(0,0,0,.14), 0 0 0 1px var(--line); font-size: 13.5px; }
  .infobox caption { caption-side: top; text-align: left; padding: 12px 14px; background: #fff; border-radius: 16px 16px 0 0; font-weight: 900; border-bottom: 1px solid var(--line); }
  .infobox caption em { float: right; font-style: normal; font-size: 10.5px; font-weight: 700; color: var(--sub); background: var(--line-soft); padding: 3px 8px; border-radius: 999px; }
  .infobox th { width: 72px; text-align: left; background: var(--line-soft); padding: 11px 12px; font-weight: 700; border-top: 1px solid var(--line); color: var(--sub); }
  .infobox td { padding: 11px 12px; font-weight: 700; border-top: 1px solid var(--line); }
  .todo { color: var(--faint); font-weight: 600; }
  .mchips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .mchips a { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 5px 12px; font-size: 13px; font-weight: 700; color: var(--text); text-decoration: none; }
  .mchips a i { width: 8px; height: 8px; border-radius: 50%; }
  .mchips a[aria-current] { background: var(--dark); border-color: var(--dark); color: #fff; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .dday, .ics { border-radius: 999px; padding: 9px 16px; font-size: 13px; font-weight: 800; text-decoration: none; }
  .dday { background: var(--accent); color: var(--accent-ink); }
  .dday em { font-style: normal; opacity: .75; margin-left: 4px; }
  .ics { background: var(--dark); color: #fff; }
  .tabs { position: sticky; top: 60px; z-index: 5; display: flex; gap: 6px; margin: 26px 0 8px; padding: 10px 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .tabs a { flex: none; padding: 7px 14px; border-radius: 999px; font-size: 13.5px; font-weight: 750; color: var(--sub); text-decoration: none; }
  .tabs a.on { background: var(--dark); color: #fff; }
  .sec { margin-top: 30px; scroll-margin-top: 120px; }
  .sec-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .sec-head h2 { margin: 0; font-size: 26px; letter-spacing: -.035em; }
  .auto { font-size: 11px; font-weight: 800; color: #4b6500; background: color-mix(in srgb, var(--accent) 35%, white); padding: 4px 10px; border-radius: 999px; }
  .sec-sub { margin: 6px 0 18px; color: var(--sub); font-size: 13px; }
  .ycard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px; margin-bottom: 14px; }
  .ycard.now { border-color: color-mix(in srgb, var(--dot) 60%, white); box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 18%, transparent); }
  .ycard-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .ycard-head h3 { margin: 0; font-size: 26px; letter-spacing: -.04em; }
  .ycard-head small { margin-left: auto; color: var(--faint); font-size: 11.5px; }
  .ycard ul { list-style: none; margin: 0; padding: 0; }
  .ycard li + li { border-top: 1px solid var(--line-soft); }
  .ycard li a { display: flex; align-items: center; gap: 12px; padding: 10px 0; color: inherit; text-decoration: none; min-width: 0; }
  .yc-cover { width: 44px; flex: none; }
