---
/**
 * 어드민: 확인 대기 제보 승인·거절, 물어보기 👎 확인, 응원법 채보 도구
 * 로그인은 Cloudflare Access + middleware.ts 확인. 사이트 메뉴에는 링크를 두지 않는다.
 */
import Base from '../../layouts/Base.astro';
import { loadPublic } from '../../lib/data';
const email = Astro.locals.admin?.email ?? '';
// 채보 큐의 멤버 고르기용 (slug·이름)
const memberData = await loadPublic<{ members?: { slug: string; name: string }[] }>(Astro.locals, 'members.json', {}).catch(() => ({ members: [] }));
const members = (memberData.members ?? []).map((m) => ({ slug: m.slug, name: m.name }));
// 채보 상수 (config/fanchant.json → publish 때 fanchant/index.json 의 config)
const fanchantIndex = await loadPublic<{ config?: Record<string, unknown> }>(Astro.locals, 'fanchant/index.json', {}).catch(() => ({ config: {} }));
---
<Base title="어드민" current="admin" noindex>
  <main class="wrap admin">
    <header class="admin-head">
      <div>
        <p class="eyebrow">ADMIN · 운영자</p>
        <h1>확인할 것</h1>
      </div>
      <div class="admin-who">
        <span>{email}</span>
        <a href="/cdn-cgi/access/logout">로그아웃</a>
      </div>
    </header>

    <div class="admin-tabs" role="tablist" aria-label="어드민 메뉴">
      <button type="button" role="tab" id="tab-reports" aria-controls="panel-reports" aria-selected="true">제보 <span class="n" data-count="reports"></span></button>
      <button type="button" role="tab" id="tab-feedback" aria-controls="panel-feedback" aria-selected="false">물어보기 👎 <span class="n" data-count="feedback"></span></button>
      <button type="button" role="tab" id="tab-charts" aria-controls="panel-charts" aria-selected="false">응원법 채보</button>
    </div>

    <section id="panel-reports" role="tabpanel" aria-labelledby="tab-reports">
      <p class="admin-hint">AI가 자동으로 판단하지 못한 제보예요. 승인·거절은 다음 수집(15~30분 안)에 반영돼요.</p>
      <div id="reports-pending" class="admin-list"><div class="card admin-item" aria-hidden="true"><span class="skel-line w60"></span><span class="skel-line w80"></span><span class="skel-line w40"></span></div></div>
      <h2 class="admin-sub">최근 처리한 제보 (14일)</h2>
      <div id="reports-recent" class="admin-list"></div>
    </section>

    <section id="panel-feedback" role="tabpanel" aria-labelledby="tab-feedback" hidden>
      <div class="admin-bar">
        <p class="admin-hint" id="feedback-summary">최근 평가를 불러오는 중…</p>
        <label class="admin-days">기간
          <select id="feedback-days"><option value="7">7일</option><option value="14" selected>14일</option><option value="30">30일</option><option value="60">60일</option></select>
        </label>
      </div>
      <p class="admin-hint">"평가 세트 후보로"를 누른 것만 <code>npm run ask:feedback -- --to-eval</code>이 모아요.</p>
      <div id="feedback-list" class="admin-list"><div class="card admin-item" aria-hidden="true"><span class="skel-line w60"></span><span class="skel-line w80"></span><span class="skel-line w40"></span></div></div>
    </section>

    <section id="panel-charts" role="tabpanel" aria-labelledby="tab-charts" hidden data-members={JSON.stringify(members)} data-config={JSON.stringify(fanchantIndex.config ?? {})}>
      <div id="charts-home">
        <div class="admin-bar">
          <p class="admin-hint">공식 응원법 가이드를 보며 손으로 찍는 채보예요. "공개"를 켠 채보만 다음 수집(30분 안) 때 게임에 나와요.</p>
          <div class="admin-actions">
            <button type="button" class="admin-btn is-primary" id="chart-new">새 채보</button>
            <label class="admin-btn">JSON 불러오기<input type="file" id="chart-import" accept="application/json,.json" hidden /></label>
          </div>
        </div>
        <div id="chart-draft-note"></div>
        <div id="charts-list" class="admin-list"><div class="card admin-item" aria-hidden="true"><span class="skel-line w60"></span><span class="skel-line w40"></span></div></div>
      </div>

      <div id="chart-editor" hidden>
        <div class="ed-top">
          <button type="button" class="admin-btn" id="ed-back">← 목록</button>
          <strong id="ed-title" class="ed-title">새 채보</strong>
          <span id="ed-status" class="admin-status" aria-live="polite"></span>
          <span class="ed-top-actions">
            <a class="admin-btn" id="ed-try" href="/admin/play" target="_blank" rel="noopener" hidden>시험 플레이</a>
            <button type="button" class="admin-btn" id="ed-download">JSON 내려받기</button>
            <button type="button" class="admin-btn" id="ed-delete" hidden>지우기</button>
            <button type="button" class="admin-btn is-primary" id="ed-save">저장</button>
          </span>
        </div>
        <div id="ed-conflict" class="admin-reason" hidden></div>

        <details class="card ed-meta" id="ed-meta" open>
          <summary>곡 정보 · 영상</summary>
          <div class="ed-fields">
            <label>곡 ID <input data-f="songId" placeholder="when-im-with-you" autocomplete="off" spellcheck="false" /></label>
            <label class="w2">제목 <input data-f="title" placeholder="곡 제목" /></label>
            <label>앨범 <input data-f="album" /></label>
            <label>연도 <input data-f="year" inputmode="numeric" /></label>
            <label>노래 길이(초) <span class="ed-inline"><input data-f="durationSec" inputmode="decimal" /><button type="button" class="admin-btn ed-mini" id="ed-dur">영상에서</button></span></label>
            <label>BPM <input data-f="bpm" inputmode="decimal" /></label>
            <label>난이도 <select data-f="difficulty"><option value="1">1 · 쉬움</option><option value="2">2 · 보통</option><option value="3">3 · 보통</option><option value="4">4 · 조금 어려움</option><option value="5">5 · 어려움</option></select></label>
            <label>제작자 표시명 <input data-f="author" placeholder="@dreamarchive" /></label>
            <label class="ed-check"><input type="checkbox" data-f="verified" /> 공개 (게임에 나옴)</label>
          </div>
          <div class="ed-videos">
            <div class="ed-video" data-mode="guide">
              <h3>연습용 · 공식 응원법 가이드</h3>
              <label>유튜브 주소 <input data-v="youtubeId" placeholder="https://www.youtube.com/watch?v=…" spellcheck="false" /></label>
              <label>노래 시작 오프셋(초) <span class="ed-inline"><input data-v="offset" inputmode="decimal" /><button type="button" class="admin-btn ed-mini" data-act="offset-now">지금 위치로</button></span></label>
              <span class="ed-inline ed-shift-video">이 영상만 큐 옮기기 (←앞으로 · 뒤로→ 초) <button type="button" class="admin-btn ed-mini" data-act="off" data-d="-0.05">← 0.05</button><button type="button" class="admin-btn ed-mini" data-act="off" data-d="-0.01">← 0.01</button><button type="button" class="admin-btn ed-mini" data-act="off" data-d="0.01">0.01 →</button><button type="button" class="admin-btn ed-mini" data-act="off" data-d="0.05">0.05 →</button></span>
              <div class="ed-segs"></div>
              <button type="button" class="admin-btn ed-mini" data-act="seg-add">구간 오프셋 추가</button>
            </div>
            <div class="ed-video" data-mode="mv">
              <h3>실전용 · 공식 뮤비</h3>
              <label>유튜브 주소 <input data-v="youtubeId" placeholder="없으면 비워 두기 (실전 꺼짐)" spellcheck="false" /></label>
              <label>노래 시작 오프셋(초) <span class="ed-inline"><input data-v="offset" inputmode="decimal" /><button type="button" class="admin-btn ed-mini" data-act="offset-now">지금 위치로</button></span></label>
              <span class="ed-inline ed-shift-video">이 영상만 큐 옮기기 (←앞으로 · 뒤로→ 초) <button type="button" class="admin-btn ed-mini" data-act="off" data-d="-0.05">← 0.05</button><button type="button" class="admin-btn ed-mini" data-act="off" data-d="-0.01">← 0.01</button><button type="button" class="admin-btn ed-mini" data-act="off" data-d="0.01">0.01 →</button><button type="button" class="admin-btn ed-mini" data-act="off" data-d="0.05">0.05 →</button></span>
              <div class="ed-segs"></div>
              <button type="button" class="admin-btn ed-mini" data-act="seg-add">구간 오프셋 추가</button>
            </div>
          </div>
          <p class="admin-hint">오프셋은 그 영상에서 노래가 시작되는 시각이에요. 큐는 노래 시각으로 저장되니까, 뮤비는 오프셋만 맞추면 같은 채보가 그대로 맞아요. 드라마 장면처럼 중간에 어긋나는 곳만 구간 오프셋(영상 시각 시작~끝)을 넣어 주세요.</p>
        </details>

        <div class="ed-grid">
          <div class="ed-player-col">
            <div class="ed-modes" role="radiogroup" aria-label="재생할 영상">
              <button type="button" role="radio" data-mode="guide" aria-checked="true">가이드</button>
              <button type="button" role="radio" data-mode="mv" aria-checked="false">뮤비</button>
            </div>
            <div class="ed-yt"><div id="ed-player"><div class="ed-yt-empty">위 "곡 정보 · 영상"에 유튜브 주소를 넣으면 여기서 재생돼요</div></div></div>
            <p class="ed-yt-badge">YouTube 플레이어 · 항상 보이기</p>
            <div class="ed-now">
              <span id="ed-clock" class="ed-clock">영상 0:00.00 · 노래 0:00.00</span>
              <span id="ed-state" class="admin-status"></span>
            </div>
            <div id="ed-flash" class="ed-flash" aria-hidden="true"></div>
            <div class="ed-controls">
              <button type="button" class="admin-btn" data-seek="-5">−5초</button>
              <button type="button" class="admin-btn" data-seek="-1">−1초</button>
              <button type="button" class="admin-btn is-primary" id="ed-play">▶ 재생</button>
              <button type="button" class="admin-btn" data-seek="1">+1초</button>
              <button type="button" class="admin-btn" data-seek="5">+5초</button>
              <label class="admin-days">속도 <select id="ed-rate"><option value="0.5">0.5×</option><option value="0.75">0.75×</option><option value="1" selected>1×</option></select></label>
              <label class="admin-days"><input type="checkbox" id="ed-tick" /> 큐마다 틱 소리</label>
            </div>
            <div class="ed-rec">
              <button type="button" class="admin-btn" id="ed-rec" aria-pressed="false"><span class="ed-rec-dot"></span> 녹음 시작</button>
              <button type="button" class="admin-btn" id="ed-undo" disabled>한 박자 되돌리기</button>
              <button type="button" class="ed-tap" id="ed-tap">TAP</button>
            </div>
            <p id="ed-focus" class="admin-reason" hidden>영상 밖 빈 곳을 한 번 눌러 주세요. 그래야 스페이스로 찍을 수 있어요.</p>
            <p class="admin-hint ed-help">녹음을 켜고 재생하면서 스페이스(또는 TAP)로 큐를 찍고, 찍힌 줄에 문구(예: 런쥔!)를 적어 주세요. 키: 스페이스 찍기·재생, ←/→ 2초, Z 되돌리기, 쉼표/마침표 선택한 큐 −/+10ms.</p>
          </div>

          <div class="card ed-cue-panel">
            <div class="ed-cue-head">
              <strong id="ed-cue-count">큐 0개</strong>
              <span class="ed-inline">
                <input id="ed-shift" inputmode="numeric" placeholder="±ms" aria-label="전체 큐 옮기기 (ms)" />
                <button type="button" class="admin-btn ed-mini" id="ed-shift-go">전체 옮기기</button>
              </span>
            </div>
            <ol id="ed-cues" class="ed-cues"></ol>
            <details class="ed-bulk">
              <summary>문구 한꺼번에 채우기</summary>
              <textarea id="ed-bulk" rows="5" placeholder="한 줄에 한 문구씩&#10;런쥔!&#10;제노!&#10;해찬!"></textarea>
              <button type="button" class="admin-btn ed-mini" id="ed-bulk-go">선택한 큐부터 차례로 채우기</button>
            </details>
          </div>
        </div>

        <div class="ed-tl-block">
          <div class="ed-tl" id="ed-tl" role="slider" aria-label="타임라인 (누르면 그 위치로)" aria-valuemin="0" tabindex="0">
            <div class="ed-tl-marks" id="ed-tl-marks"></div>
            <div class="ed-tl-head" id="ed-tl-head"></div>
          </div>
          <div class="ed-tl-times"><span>0:00</span><span id="ed-tl-end"></span></div>
        </div>
        <ul id="ed-issues" class="ed-issues"></ul>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .admin { padding-top: 24px; padding-bottom: 40px; }
  .admin-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .admin-head h1 { margin: 4px 0 0; font-size: 28px; }
  .admin-who { display: flex; gap: 12px; align-items: center; font-size: 13px; color: var(--sub); }
  .admin-who a { color: var(--text); }
  .admin-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--line); margin-bottom: 16px; overflow-x: auto; }
  .admin-tabs button { border: 0; background: none; padding: 10px 12px; font: inherit; font-weight: 600; color: var(--sub); border-bottom: 2px solid transparent; cursor: pointer; white-space: nowrap; }
  .admin-tabs button[aria-selected='true'] { color: var(--text); border-bottom-color: var(--accent); }
  .admin-tabs .n { color: var(--faint); font-weight: 500; }
  .admin-hint { color: var(--sub); font-size: 13px; margin: 0 0 12px; }
  .admin-sub { font-size: 15px; margin: 28px 0 10px; }
  .admin-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .admin-days { font-size: 13px; color: var(--sub); display: flex; gap: 6px; align-items: center; }
  .admin-list { display: grid; gap: 10px; }
  .admin-empty { padding: 20px; color: var(--sub); font-size: 14px; }
  .admin-item { padding: 14px 16px; min-width: 0; }
  .admin-item.is-done { opacity: .62; }
  .admin-item-top { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 12px; color: var(--sub); margin-bottom: 6px; }
  .admin-tag { border-radius: 999px; padding: 2px 8px; background: var(--line-soft); color: var(--text); font-weight: 600; }
  .admin-tag.t-add { background: #e7f0ff; } .admin-tag.t-delete { background: #ffe8ea; } .admin-tag.t-fix { background: #fff4dc; } .admin-tag.t-news { background: #eef9d6; }
  .admin-tag.s-approved { background: var(--accent); color: var(--accent-ink); } .admin-tag.s-rejected { background: #ffe8ea; }
  .admin-item h3 { margin: 0 0 6px; font-size: 15px; word-break: break-word; }
  .admin-item dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 10px; margin: 0 0 8px; font-size: 13px; }
  .admin-item dt { color: var(--sub); }
  .admin-item dd { margin: 0; word-break: break-word; }
  .admin-reason { font-size: 13px; background: var(--today); border-radius: 8px; padding: 8px 10px; margin: 0 0 10px; }
  .admin-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .admin-actions input { flex: 1 1 200px; min-width: 0; border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; font: inherit; font-size: 13px; }
  .admin-btn { border: 1px solid var(--line); background: var(--card); border-radius: 999px; padding: 6px 14px; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; min-height: 34px; }
  .admin-btn.is-primary { background: var(--dark); color: #fff; border-color: var(--dark); }
  .admin-btn.is-accent { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .admin-btn:disabled { opacity: .5; cursor: default; }
  .admin-status { font-size: 12px; color: var(--sub); }
  .admin-answer { font-size: 13px; color: var(--text); white-space: pre-wrap; background: var(--line-soft); border-radius: 8px; padding: 8px 10px; margin: 6px 0; max-height: 180px; overflow: auto; }
  .admin-fb { border-top: 1px solid var(--line-soft); padding-top: 8px; margin-top: 8px; }
  .admin-fb:first-of-type { border-top: 0; padding-top: 0; }
  .admin-srcs { font-size: 12px; display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .admin-srcs a { color: var(--sub); }
  /* 응원법 채보 도구 */
  .ed-top { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
  .ed-title { font-size: 17px; }
  .ed-top-actions { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
  a.admin-btn { display: inline-flex; align-items: center; text-decoration: none; color: var(--text); box-sizing: border-box; }
  .ed-meta { padding: 12px 16px; margin-bottom: 14px; }
  .ed-meta summary { cursor: pointer; font-weight: 700; }
  .ed-fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px 12px; margin: 12px 0; }
  .ed-fields .w2 { grid-column: span 2; }
  .ed-meta label, .ed-video label { display: grid; gap: 4px; font-size: 12px; color: var(--sub); min-width: 0; }
  .ed-meta input:not([type='checkbox']), .ed-meta select, .ed-cue-panel input, .ed-cue-panel select, .ed-bulk textarea { border: 1px solid var(--line); border-radius: 8px; padding: 7px 9px; font: inherit; font-size: 13px; color: var(--text); background: var(--card); min-width: 0; width: 100%; box-sizing: border-box; }
  .ed-meta .ed-check { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text); font-weight: 600; }
  .ed-inline { display: flex; gap: 6px; align-items: center; min-width: 0; }
  .admin-btn.ed-mini { padding: 4px 10px; min-height: 30px; font-size: 12px; white-space: nowrap; }
  .ed-videos { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 8px; }
  .ed-video { display: grid; gap: 8px; align-content: start; border: 1px solid var(--line-soft); border-radius: 10px; padding: 10px 12px; }
  .ed-video h3 { margin: 0; font-size: 13px; }
  .ed-shift-video { font-size: 12px; color: var(--sub); flex-wrap: wrap; }
  .ed-seg { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 6px; align-items: end; }
  .ed-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  @media (max-width: 900px) { .ed-grid { grid-template-columns: minmax(0, 1fr); } .ed-fields .w2 { grid-column: auto; } }
  .ed-modes { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; margin-bottom: 8px; background: var(--card); }
  .ed-modes button { border: 0; background: none; border-radius: 999px; padding: 5px 14px; font: inherit; font-size: 13px; font-weight: 600; color: var(--sub); cursor: pointer; }
  .ed-modes button[aria-checked='true'] { background: var(--dark); color: #fff; }
  .ed-yt { position: relative; aspect-ratio: 16 / 9; background: var(--dark); border-radius: 12px; overflow: hidden; }
  .ed-yt > div, .ed-yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ed-yt-empty { display: grid; place-items: center; color: #bbb; font-size: 13px; padding: 20px; text-align: center; }
  .ed-yt-badge { font-size: 11px; color: var(--faint); margin: 4px 0 8px; }
  .ed-now { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; font-size: 13px; }
  .ed-clock { font-variant-numeric: tabular-nums; font-weight: 600; }
  .ed-flash { height: 44px; display: grid; place-items: center; font-size: 22px; font-weight: 800; border-radius: 10px; margin: 8px 0; background: var(--line-soft); color: var(--sub); transition: background .25s, color .25s; }
  .ed-flash.is-on { background: var(--accent); color: var(--accent-ink); transition: none; }
  .ed-controls, .ed-rec { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
  .ed-rec-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--faint); vertical-align: middle; margin-right: 2px; }
  #ed-rec[aria-pressed='true'] { border-color: #e5484d; color: #c62a2f; }
  #ed-rec[aria-pressed='true'] .ed-rec-dot { background: #e5484d; animation: ed-blink 1s steps(2) infinite; }
  @keyframes ed-blink { 50% { opacity: .2; } }
