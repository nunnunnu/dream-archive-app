---
/** 어드민 시험 플레이: KV의 채보(초안 포함)를 바로 해 본다. 기록은 남기지 않는다 (middleware.ts가 로그인 확인) */
import Base from '../../layouts/Base.astro';
import GamePlay from '../../components/GamePlay.astro';
import { loadPublic } from '../../lib/data';
import { checkChart, FANCHANT_DEFAULTS, SONG_ID, type FanchantConfig } from '../../lib/fanchant';
const q = Astro.url.searchParams;
const song = q.get('song') ?? '';
const mode = (['step1', 'step2', 'step3', 'live'] as const).find((m) => m === q.get('mode')) ?? 'step1';
const from = q.has('from') ? Number(q.get('from')) : undefined;
const to = q.has('to') ? Number(q.get('to')) : undefined;
const kv = Astro.locals.runtime?.env?.REPORTS;
const raw = kv && SONG_ID.test(song) ? await kv.get(`chart:${song}`, 'json') : null;
const chart = raw ? checkChart({ ...(raw as object), verified: false }).chart : null;
const index = await loadPublic<{ config?: Partial<FanchantConfig> }>(Astro.locals, 'fanchant/index.json', {});
const config = { ...FANCHANT_DEFAULTS, ...(index.config ?? {}) };
const range = from != null && to != null && Number.isFinite(from) && Number.isFinite(to) && to > from;
---
<Base title="시험 플레이" current="admin" noindex theme="dark">
  {chart ? (
    <GamePlay chart={chart} config={config} mode={mode} from={range ? from : undefined} to={range ? to : undefined} backHref="/admin/" preview />
  ) : (
    <main class="wrap" style="padding:40px 20px"><p>그 채보를 찾지 못했어요 (저장했는지 확인해 주세요).</p><a href="/admin/">어드민으로</a></main>
  )}
</Base>
