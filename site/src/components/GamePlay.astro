---
/**
 * 응원법 게임 플레이 화면 (공개 /game/play, 어드민 시험 플레이 /admin/play 공용)
 * 채보와 설정은 JSON으로 심고 동작은 scripts/game/play.ts
 */
import { judgeWindow, type FanchantChart, type FanchantConfig } from '../lib/fanchant';
import '../styles/game.css';
interface Props { chart: FanchantChart; config: FanchantConfig; mode: 'step1' | 'step2' | 'step3' | 'live'; from?: number; to?: number; backHref: string; preview?: boolean }
const { chart, config, mode, from, to, backHref, preview } = Astro.props;
const LABEL = { step1: '1단계 · 전체 힌트', step2: '2단계 · 직전 힌트', step3: '3단계 · 뮤비 + 직전 힌트', live: '실전 · 힌트 없음' };
const BADGE = { step1: 'game-badge-pr', step2: 'game-badge-s2', step3: 'game-badge-s2', live: 'game-badge-vs' };
const mv = mode === 'step3' || mode === 'live';
const late = mode === 'step2' || mode === 'step3';
const hasMv = chart.videos.some((v) => v.mode === 'mv');
const win = judgeWindow(config, mode);
const data = { chart, config, mode, from: from ?? null, to: to ?? null, backHref, preview: Boolean(preview) };
---
<div class="game-play" data-mode={mode}>
  <div class="wrap game-bar">
    <a class="game-bar-back" href={backHref}>← {preview ? '채보 도구' : '곡 선택'}</a>
    <div class="game-bar-song">
      <strong>{chart.title}</strong>
      <span>{mv ? '공식 뮤비' : '공식 응원법 가이드'}{from != null ? ' · 구간 연습' : ''}{preview ? ' · 시험 플레이 (기록 안 남음)' : ''}</span>
    </div>
    <span class={`game-badge ${BADGE[mode]}`}>{LABEL[mode]}</span>
    <div class="game-hud">
      <div class="game-hud-item"><b id="g-time">0:00</b><span id="g-dur">0:00</span></div>
      <div class="game-hud-item is-combo"><b id="g-combo">0</b><span>COMBO</span></div>
      <div class="game-hud-item"><b id="g-score">0</b><span>SCORE</span></div>
    </div>
  </div>
  <div class="game-progress" role="progressbar" aria-label="진행" aria-valuemin="0" aria-valuemax="100"><div class="game-progress-fill" id="g-progress"></div></div>

  <div class="wrap game-stage" id="game-stage">
    <div class:list={['game-yt', mv && 'game-yt-live']}>
      <div class="game-yt-frame"><div id="game-yt-player"></div></div>
    </div>
    <p class="game-yt-badge">YouTube 플레이어 · 항상 보이기</p>

    <div class="game-notice" id="g-notice" aria-live="polite">
      <span id="g-notice-text">유튜브 영상이라 광고가 나올 수 있어요. 광고가 끝나면 게임이 시작돼요</span>
      <button type="button" class="game-start" id="g-start" disabled>불러오는 중…</button>
    </div>

    {mv && !hasMv ? (
      <p class="game-notice is-warn">이 곡은 공식 뮤비 오프셋이 아직 없어서 {mode === 'live' ? '실전을' : '3단계를'} 할 수 없어요.</p>
    ) : (
      <div class:list={['game-play-row', mode === 'live' && 'is-live']}>
        <div class="game-play-main">
          {mode === 'live' ? (
            <div class="game-live-feedback">
              <p class="game-live-hint" id="g-live-hint">힌트 없음 · 외운 대로 눌러보세요</p>
              <div class="game-live-judge" id="g-judge" aria-live="polite"></div>
            </div>
          ) : (
            <>
              <div class:list={['game-chant', late && 'is-late']} id="g-chant" aria-live="off">{late ? <span class="game-chant-wait">누른 뒤에 정답이 떠요</span> : ''}</div>
              <div class:list={['game-lane', late && 'game-lane-late']} id="g-lane" aria-label={`판정선. 판정 ±${win.goodMs}ms`}>
                {late && <span class="game-lane-cap">노트는 직전에만 보여요</span>}
                <div class="game-hit"><span class="game-hit-ring"></span></div>
                <div class="game-notes" id="g-notes"></div>
              </div>
              <div class="game-judge" id="g-judge" aria-live="polite"></div>
            </>
          )}
        </div>
        <div class="game-stick-wrap">
          <span class="game-stick-pop" id="g-stick-pop" aria-hidden="true"></span>
          <button type="button" class="game-tap game-stick" id="g-tap" aria-label="응원봉 (스페이스)">
            <svg class="game-stick-svg" viewBox="0 0 120 200" aria-hidden="true">
              <defs>
                <linearGradient id="stk-h" x1="0" x2="1"><stop offset="0" stop-color="#cfcfca" /><stop offset=".45" stop-color="#ffffff" /><stop offset="1" stop-color="#c6c6c0" /></linearGradient>
                <radialGradient id="stk-core" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fbffe6" /><stop offset=".45" stop-color="#dcff5a" /><stop offset="1" stop-color="#b6ea1c" stop-opacity="0" /></radialGradient>
              </defs>
              <rect x="51" y="96" width="18" height="98" rx="9" fill="url(#stk-h)" />
              <circle cx="60" cy="124" r="3" fill="none" stroke="#b9b9b3" stroke-width="1.2" />
              <g class="stk-cube">
                <polygon points="20,36 60,54 60,104 20,86" fill="#9fd41a" fill-opacity=".5" />
                <polygon points="60,54 100,36 100,86 60,104" fill="#c5f03a" fill-opacity=".55" />
                <polygon points="60,18 100,36 60,54 20,36" fill="#e6ff86" fill-opacity=".6" />
                <circle class="stk-glow" cx="60" cy="62" r="36" fill="url(#stk-core)" />
                <g fill="none" stroke="#f4ffc4" stroke-opacity=".55" stroke-width="1.2"><polygon points="60,18 100,36 100,86 60,104 20,86 20,36" /><polyline points="20,36 60,54 100,36" /><line x1="60" y1="54" x2="60" y2="104" /></g>
                <path class="stk-d" transform="matrix(1,-0.45,0,1,60,54)" fill-rule="evenodd" d="M11 13h9a11 14 0 0 1 0 28h-9z M16.5 19v16h3a5.5 8 0 0 0 0-16z" />
              </g>
            </svg>
            <span class="sr-only">TAP</span>
          </button>
        </div>
      </div>
    )}
    <p class="game-tap-hint">스페이스바 또는 응원봉을 눌러요 · 판정 ±{win.goodMs}ms</p>
    <p class="game-focus" id="g-focus" hidden>영상을 누르면 스페이스가 영상으로 가요. 응원봉을 한 번 누르면 이어서 할 수 있어요.</p>
    <div class="game-foot">
      <span class="game-author">채보 {chart.author}</span>
      <span class="game-calib">입력 보정
        <button type="button" data-calib="-10" aria-label="보정 10ms 줄이기">−</button>
        <b id="g-calib">0ms</b>
        <button type="button" data-calib="10" aria-label="보정 10ms 늘리기">+</button>
        <button type="button" class="game-calib-reset" data-calib="reset" aria-label="입력 보정 초기화">초기화</button>
      </span>
    </div>
  </div>

  <section class="wrap game-result" id="game-result" hidden aria-live="polite"></section>
</div>
<script type="application/json" id="game-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
<script src="../scripts/game/play.ts"></script>
