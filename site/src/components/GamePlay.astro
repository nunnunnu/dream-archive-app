---
/**
 * 응원법 게임 플레이 화면 (공개 /game/play, 어드민 시험 플레이 /admin/play 공용)
 * 채보와 설정은 JSON으로 심고 동작은 scripts/game/play.ts
 */
import { judgeWindow, type FanchantChart, type FanchantConfig } from '../lib/fanchant';
import '../styles/game.css';
interface Props { chart: FanchantChart; config: FanchantConfig; mode: 'step1' | 'step2' | 'step3' | 'live'; from?: number; to?: number; backHref: string; preview?: boolean }
const { chart, config, mode, from, to, backHref, preview } = Astro.props;
const LABEL = { step1: '1단계 · 전체 힌트', step2: '2단계 · 직전 힌트', step3: '3단계 · 뮤비 + 직전 힌트', live: '실전 · 힌트 없음' };
const BADGE = { step1: 'game-badge-pr', step2: 'game-badge-s2', step3: 'game-badge-s2', live: 'game-badge-vs' };
const mv = mode === 'step3' || mode === 'live';
const late = mode === 'step2' || mode === 'step3';
const hasMv = chart.videos.some((v) => v.mode === 'mv');
const win = judgeWindow(config, mode);
const data = { chart, config, mode, from: from ?? null, to: to ?? null, backHref, preview: Boolean(preview) };
---
<div class="game-play" data-mode={mode}>
  <div class="wrap game-bar">
    <a class="game-bar-back" href={backHref}>← {preview ? '채보 도구' : '곡 선택'}</a>
    <div class="game-bar-song">
      <strong>{chart.title}</strong>
      <span>{mv ? '공식 뮤비' : '공식 응원법 가이드'}{from != null ? ' · 구간 연습' : ''}{preview ? ' · 시험 플레이 (기록 안 남음)' : ''}</span>
    </div>
    <span class={`game-badge ${BADGE[mode]}`}>{LABEL[mode]}</span>
    <div class="game-hud">
      <div class="game-hud-item"><b id="g-time">0:00</b><span id="g-dur">0:00</span></div>
      <div class="game-hud-item is-combo"><b id="g-combo">0</b><span>COMBO</span></div>
      <div class="game-hud-item"><b id="g-score">0</b><span>SCORE</span></div>
    </div>
  </div>
  <div class="game-progress" role="progressbar" aria-label="진행" aria-valuemin="0" aria-valuemax="100"><div class="game-progress-fill" id="g-progress"></div></div>

  <div class="wrap game-stage" id="game-stage">
    <div class:list={['game-yt', mv && 'game-yt-live']}>
      <div class="game-yt-frame"><div id="game-yt-player"></div></div>
    </div>

    <div class="game-notice" id="g-notice" aria-live="polite">
      <span id="g-notice-text">유튜브 영상이라 광고가 나올 수 있어요. 광고가 끝나면 게임이 시작돼요</span>
      <button type="button" class="game-start" id="g-start" disabled>불러오는 중…</button>
    </div>

    {mv && !hasMv ? (
      <p class="game-notice is-warn">이 곡은 아직 뮤비로 할 수 없어요. 1·2단계로 연습해 보세요.</p>
    ) : (
      <div class:list={['game-play-row', mode === 'live' && 'is-live']}>
        <div class="game-play-main">
          {mode === 'live' ? (
            <div class="game-live-feedback">
              <p class="game-live-hint" id="g-live-hint">힌트 없음 · 외운 대로 눌러보세요</p>
              <div class="game-live-judge" id="g-judge" aria-live="polite"></div>
            </div>
          ) : (
            <>
              <div class:list={['game-chant', late && 'is-late']} id="g-chant" aria-live="off">{late ? <span class="game-chant-wait">누른 뒤에 정답이 떠요</span> : ''}</div>
              <div class:list={['game-lane', late && 'game-lane-late']} id="g-lane" aria-label={`판정선. 판정 ±${win.goodMs}ms`}>
                {late && <span class="game-lane-cap">노트는 직전에만 보여요</span>}
                <div class="game-hit"><span class="game-hit-ring"></span></div>
                <div class="game-notes" id="g-notes"></div>
              </div>
              <div class="game-judge" id="g-judge" aria-live="polite"></div>
            </>
          )}
        </div>
        <div class="game-stick-wrap">
          <span class="game-stick-pop" id="g-stick-pop" aria-hidden="true"></span>
          <button type="button" class="game-tap game-stick" id="g-tap" aria-label="응원봉 (스페이스)">
            <svg class="game-stick-svg" viewBox="0 0 200 240" aria-hidden="true">
              <defs>
                <radialGradient id="stk-aura" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#c5f03a" stop-opacity=".55" /><stop offset=".55" stop-color="#c5f03a" stop-opacity=".16" /><stop offset="1" stop-color="#c5f03a" stop-opacity="0" /></radialGradient>
                <linearGradient id="stk-h" x1="0" x2="1"><stop offset="0" stop-color="#bdbdb6" /><stop offset=".35" stop-color="#ffffff" /><stop offset=".7" stop-color="#ecece6" /><stop offset="1" stop-color="#a9a9a2" /></linearGradient>
                <linearGradient id="stk-top" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f1ffb2" /><stop offset="1" stop-color="#d4f758" /></linearGradient>
                <linearGradient id="stk-left" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b8e636" /><stop offset="1" stop-color="#7fae0c" /></linearGradient>
                <linearGradient id="stk-right" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d9fb6a" /><stop offset="1" stop-color="#9ccc18" /></linearGradient>
                <radialGradient id="stk-core" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffffff" /><stop offset=".35" stop-color="#f3ffb8" /><stop offset=".75" stop-color="#d6ff4a" stop-opacity=".7" /><stop offset="1" stop-color="#c5f03a" stop-opacity="0" /></radialGradient>
                <clipPath id="stk-cl"><polygon points="42,47 100,74 100,136 42,109" /></clipPath>
                <clipPath id="stk-cr"><polygon points="100,74 158,47 158,109 100,136" /></clipPath>
                <clipPath id="stk-ct"><polygon points="100,20 158,47 100,74 42,47" /></clipPath>
              </defs>
              <circle class="stk-aura" cx="100" cy="80" r="98" fill="url(#stk-aura)" />
              <!-- 손잡이 -->
              <rect x="85" y="118" width="30" height="114" rx="15" fill="url(#stk-h)" />
              <rect x="91" y="132" width="4" height="88" rx="2" fill="#fff" opacity=".7" />
              <ellipse cx="100" cy="128" rx="17" ry="6" fill="#e8e8e2" />
              <circle cx="100" cy="164" r="4" fill="none" stroke="#b5b5ae" stroke-width="1.4" />
              <!-- 둥근 반투명 큐브 -->
              <g class="stk-cube" stroke-linejoin="round" stroke-width="10">
                <polygon points="42,47 100,74 100,136 42,109" fill="url(#stk-left)" stroke="#a8d824" fill-opacity=".78" stroke-opacity=".78" />
                <polygon points="100,74 158,47 158,109 100,136" fill="url(#stk-right)" stroke="#c2ec3f" fill-opacity=".8" stroke-opacity=".8" />
                <polygon points="100,20 158,47 100,74 42,47" fill="url(#stk-top)" stroke="#e4ff8c" fill-opacity=".85" stroke-opacity=".85" />
              </g>
              <!-- 아크릴 결 -->
              <g stroke="#ffffff" stroke-opacity=".2" stroke-width="1.2">
                <g clip-path="url(#stk-cl)"><path d="M48 50v62M54 53v62M60 56v62M66 59v62M72 62v62M78 64v62M84 67v62M90 70v62M96 72v62" /></g>
                <g clip-path="url(#stk-cr)"><path d="M104 72v62M110 70v62M116 67v62M122 64v62M128 62v62M134 59v62M140 56v62M146 53v62M152 50v62" /></g>
                <g clip-path="url(#stk-ct)"><path d="M50 43l58 27M58 39l58 27M66 35l58 27M74 31l58 27M82 27l58 27M90 23l58 27" /></g>
              </g>
              <!-- 안쪽 코어 + D -->
              <circle class="stk-glow" cx="104" cy="82" r="44" fill="url(#stk-core)" />
              <path class="stk-d" transform="matrix(1,-0.4655,0,1,100,74)" fill-rule="evenodd" d="M15 17h12a15 19.5 0 0 1 0 39h-12z M22.5 25v23h4a7.5 11.5 0 0 0 0-23z" />
              <g fill="none" stroke="#f8ffd6" stroke-opacity=".6" stroke-width="1.4" stroke-linejoin="round"><polyline points="42,47 100,74 158,47" /><line x1="100" y1="74" x2="100" y2="136" /></g>
            </svg>
            <span class="sr-only">응원봉</span>
          </button>
        </div>
      </div>
    )}
    <p class="game-tap-hint">스페이스바 또는 응원봉을 눌러요</p>
    <p class="game-focus" id="g-focus" hidden>영상을 누르면 스페이스가 영상으로 가요. 응원봉을 한 번 누르면 이어서 할 수 있어요.</p>
    <div class="game-foot">
      <span class="game-author">채보 {chart.author}</span>
      <span class="game-calib">타이밍 보정
        <button type="button" data-calib="-10" aria-label="타이밍 보정 10ms 당기기">−</button>
        <b id="g-calib">0ms</b>
        <button type="button" data-calib="10" aria-label="타이밍 보정 10ms 늦추기">+</button>
        <button type="button" class="game-calib-reset" data-calib="reset" aria-label="타이밍 보정 초기화">초기화</button>
      </span>
    </div>
  </div>

  <section class="wrap game-result" id="game-result" hidden aria-live="polite"></section>
</div>
<script type="application/json" id="game-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
<script src="../scripts/game/play.ts"></script>
