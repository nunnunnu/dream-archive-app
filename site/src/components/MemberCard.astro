---
// 멤버 사진 카드: 등록 채널의 최신 직캠 썸네일 (사진을 다시 올리지 않음). 없으면 색 그라데이션 + 이니셜
import { MEMBER_COLOR, thumbs, type MemberDoc } from '../lib/members';
interface Props { m: MemberDoc; size?: 'sm' | 'lg'; highlight?: boolean }
const { m, size = 'sm', highlight = false } = Astro.props;
const c = MEMBER_COLOR[m.slug] ?? MEMBER_COLOR.nctdream;
const t = m.photo ? thumbs(m.photo.thumb) : null;
---
<div class={`mcard mcard-${size}${highlight ? ' hl' : ''}`} style={`--from:${c.from};--to:${c.to}`}>
  {t && <img src={t.big} alt={`${m.name} 직캠 영상 썸네일`} loading="lazy" referrerpolicy="no-referrer" onerror={`if(!this.dataset.hq){this.dataset.hq=1;this.src='${t.hq}';this.classList.add('lb')}else{this.remove()}`} />}
  <span class="initial">{(m.en || m.name).slice(0, 1)}</span>
  <span class="en">{m.en}</span>
</div>
<style>
  .mcard { position: relative; aspect-ratio: 3 / 4; border-radius: 16px; overflow: hidden; background: linear-gradient(165deg, var(--from) 0%, var(--to) 100%); box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18); }
  .mcard.hl { outline: 3px solid var(--accent); outline-offset: -3px; }
  .mcard img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* hq 썸네일은 위아래 검은 띠가 있어 확대해서 가린다 */
  .mcard img.lb { transform: scale(1.34); }
  .mcard::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--from) 55%, transparent) 0%, transparent 35%, transparent 60%, color-mix(in srgb, var(--from) 80%, transparent) 100%); }
  .initial { position: absolute; left: 12px; top: 4px; z-index: 1; color: #fff; font-weight: 900; font-size: 64px; line-height: 1; letter-spacing: -0.04em; text-shadow: 0 2px 14px rgba(0, 0, 0, 0.25); }
  .en { position: absolute; left: 12px; bottom: 12px; z-index: 1; color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 0.14em; }
  .mcard-lg .initial { font-size: 72px; }
</style>
