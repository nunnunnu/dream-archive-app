# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
# 이 파일을 .env 로 복사해서 값을 넣으세요. .env 는 Git에 올라가지 않아요.
OPENAI_API_KEY=

# (선택) YouTube Data API 키. 있으면 RSS 대신 공식 API로 영상을 가져오고 과거 영상도 채울 수 있어요.
# Google Cloud 콘솔에서 YouTube Data API v3 사용 설정 후 API 키 발급
YOUTUBE_API_KEY=

# Supabase (수집 데이터·원문을 비공개 버킷에 보관, 나중에 DB·RAG). 프로젝트 Settings → API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Pages 배포 (GitHub Actions secrets 에만 넣으면 됨)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# 수집 데이터 캐시 암호화 키 (아무 긴 무작위 문자열, Actions secrets 에도 같은 값)
STATE_KEY=

# 제보·평가 KV 네임스페이스 ID (site/wrangler.toml 과 같은 값, npm run reports·ask:feedback 에서 씀)
CF_KV_REPORTS_ID=
GH_DISPATCH_TOKEN=
